---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/mobile/Header.astro';
import HorizontalNav from '../../components/mobile/HorizontalNav.astro';
import Footer from '../../components/mobile/Footer.astro';
---

<BaseLayout title="Sonharte | Fale Conosco">
  <Header />
  <HorizontalNav />
  
  <main class="flex flex-col gap-10 py-10 px-4 min-h-screen relative overflow-hidden">
    <!-- Decorações de Fundo -->
    <div class="absolute top-10 -right-20 w-72 h-72 rounded-full watercolor-blob" style="background: radial-gradient(circle, rgba(255,225,109,0.3) 0%, rgba(252,248,249,0) 70%);"></div>

    <!-- Seção de Cabeçalho -->
    <div class="text-center flex flex-col items-center gap-3 relative z-10">
      <span class="bg-primary-fixed text-on-primary-fixed text-[11px] font-label-bold px-3 py-1 border-2 border-black rounded-full shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] -rotate-1 animate-float">
        Dúvidas ou feedbacks? 💬
      </span>
      <h1 class="font-headline-xl text-3xl text-primary mt-1">Fale Conosco</h1>
      <div class="w-24 h-1.5 bg-primary mt-1 cartoon-border rounded-full"></div>
    </div>

    <!-- Canais de Contato -->
    <div class="bg-white p-6 border-4 border-on-surface rounded-2xl shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] -rotate-1 relative z-10">
      <h2 class="font-headline-md text-lg text-primary mb-4 border-b-2 border-dashed border-primary-container pb-2">Nossos Canais</h2>
      <div class="flex flex-col gap-4">
        
        <!-- Canal WhatsApp -->
        <a href="https://wa.me/5531972122639" target="_blank" class="flex items-center gap-3 p-3 border-2 border-transparent active:border-black rounded-xl active:bg-secondary-fixed transition-all">
          <div class="w-10 h-10 bg-green-100 text-green-600 rounded-lg border-2 border-black flex items-center justify-center font-bold shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] shrink-0">
            <span class="material-symbols-outlined text-xl">chat</span>
          </div>
          <div>
            <h4 class="font-headline-md text-md text-on-surface">WhatsApp</h4>
            <p class="font-body-md text-on-surface-variant text-xs">(31) 97212-2639</p>
          </div>
        </a>

        <!-- Canal Instagram -->
        <a href="https://www.instagram.com/p.sonharte/" target="_blank" class="flex items-center gap-3 p-3 border-2 border-transparent active:border-black rounded-xl active:bg-tertiary-fixed transition-all">
          <div class="w-10 h-10 bg-pink-100 text-pink-600 rounded-lg border-2 border-black flex items-center justify-center font-bold shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] shrink-0">
            <span class="material-symbols-outlined text-xl">photo_camera</span>
          </div>
          <div>
            <h4 class="font-headline-md text-md text-on-surface">Instagram</h4>
            <p class="font-body-md text-on-surface-variant text-xs">@p.sonharte</p>
          </div>
        </a>

        <!-- Canal E-mail -->
        <a href="mailto:m.sonharte@gmail.com" class="flex items-center gap-3 p-3 border-2 border-transparent active:border-black rounded-xl active:bg-primary-fixed transition-all">
          <div class="w-10 h-10 bg-blue-100 text-blue-600 rounded-lg border-2 border-black flex items-center justify-center font-bold shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] shrink-0">
            <span class="material-symbols-outlined text-xl">mail</span>
          </div>
          <div>
            <h4 class="font-headline-md text-md text-on-surface">E-mail</h4>
            <p class="font-body-md text-on-surface-variant text-xs">m.sonharte@gmail.com</p>
          </div>
        </a>

        <!-- Canal Local/Retirada -->
        <div class="flex items-center gap-3 p-3">
          <div class="w-10 h-10 bg-primary-fixed text-primary rounded-lg border-2 border-black flex items-center justify-center font-bold shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] shrink-0">
            <span class="material-symbols-outlined text-xl">location_on</span>
          </div>
          <div>
            <h4 class="font-headline-md text-md text-on-surface">Ponto de Retirada</h4>
            <p class="font-body-md text-on-surface-variant text-xs">Rua Sócrates, 679 - Belo Horizonte, MG - CEP 31990-010</p>
          </div>
        </div>

      </div>
    </div>

    <!-- Formulário Mobile -->
    <div class="relative z-10">
      <form id="contact-form-mobile" class="bg-white p-6 border-4 border-on-surface rounded-2xl shadow-[4px_4px_0px_0px_rgba(75,37,187,1)] flex flex-col gap-4 rotate-1">
        <h2 class="font-headline-md text-lg text-primary">Envie uma mensagem</h2>
        
        <div class="flex flex-col gap-1.5">
          <label for="name" class="font-label-bold text-xs text-on-surface">Seu Nome</label>
          <input 
            type="text" 
            id="name" 
            required
            placeholder="Como podemos te chamar?" 
            class="w-full px-3 py-2.5 border-2 border-on-surface rounded-lg focus:outline-none focus:border-primary text-xs font-body-md bg-background"
          />
        </div>

        <div class="flex flex-col gap-1.5">
          <label for="email" class="font-label-bold text-xs text-on-surface">Seu E-mail</label>
          <input 
            type="email" 
            id="email" 
            required
            placeholder="exemplo@email.com" 
            class="w-full px-3 py-2.5 border-2 border-on-surface rounded-lg focus:outline-none focus:border-primary text-xs font-body-md bg-background"
          />
        </div>

        <div class="flex flex-col gap-1.5">
          <label for="subject" class="font-label-bold text-xs text-on-surface">Assunto</label>
          <input 
            type="text" 
            id="subject" 
            required
            placeholder="Qual o motivo?" 
            class="w-full px-3 py-2.5 border-2 border-on-surface rounded-lg focus:outline-none focus:border-primary text-xs font-body-md bg-background"
          />
        </div>

        <div class="flex flex-col gap-1.5">
          <label for="message" class="font-label-bold text-xs text-on-surface">Mensagem</label>
          <textarea 
            id="message" 
            required
            rows="3"
            placeholder="O que você gostaria de nos dizer?" 
            class="w-full px-3 py-2.5 border-2 border-on-surface rounded-lg focus:outline-none focus:border-primary text-xs font-body-md bg-background resize-none"
          ></textarea>
        </div>

        <button 
          type="submit" 
          class="w-full bg-primary text-white py-3 border-2 border-black rounded-lg font-label-bold shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] active:translate-x-0.5 active:translate-y-0.5 active:shadow-none text-xs mt-2 flex items-center justify-center gap-1.5"
        >
          Enviar Mensagem <span class="material-symbols-outlined text-xs">send</span>
        </button>
      </form>

      <!-- Sucesso Mobile -->
      <div id="success-message-mobile" class="hidden flex flex-col items-center justify-center p-6 bg-white border-4 border-on-surface rounded-2xl shadow-[4px_4px_0px_0px_rgba(75,37,187,1)] text-center gap-3 rotate-1">
        <div class="w-12 h-12 bg-green-100 border-2 border-black rounded-full flex items-center justify-center text-green-600 animate-bounce">
          <span class="material-symbols-outlined text-2xl">check_circle</span>
        </div>
        <h3 class="font-headline-md text-lg text-on-surface">Mensagem Enviada!</h3>
        <p class="font-body-md text-on-surface-variant text-xs max-w-xs leading-relaxed">
          Seu recado foi recebido com carinho. Em breve, a Myllena retornará o contato!
        </p>
        <button 
          id="reset-form-btn-mobile"
          class="bg-secondary-fixed text-on-secondary-fixed px-5 py-2 border-2 border-black rounded-lg font-label-bold shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] active:translate-x-0.5 active:translate-y-0.5 active:shadow-none text-[11px]"
        >
          Enviar Outra
        </button>
      </div>

    </div>

    <!-- FAQ Rápido Mobile -->
    <div class="bg-secondary-fixed text-on-secondary-fixed p-5 border-4 border-on-surface rounded-2xl shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] rotate-1 relative z-10">
      <h3 class="font-headline-md text-md mb-2 flex items-center gap-2">
        <span class="material-symbols-outlined text-sm">help</span> Dicas Úteis
      </h3>
      <ul class="font-body-md text-[11px] flex flex-col gap-1.5 list-disc list-inside leading-relaxed">
        <li>Retiradas físicas devem ser agendadas previamente via WhatsApp.</li>
        <li>Enviamos frete a combinar pelo WhatsApp para todo o Brasil.</li>
        <li>Prazo médio para confeccionar personalizados: 3 a 5 dias úteis.</li>
      </ul>
    </div>

  </main>

  <Footer />
</BaseLayout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('contact-form-mobile');
    const success = document.getElementById('success-message-mobile');
    const resetBtn = document.getElementById('reset-form-btn-mobile');
    
    if (form && success && resetBtn) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        form.classList.add('hidden');
        success.classList.remove('hidden');
      });

      resetBtn.addEventListener('click', () => {
        form.reset();
        success.classList.add('hidden');
        form.classList.remove('hidden');
      });
    }
  });
</script>
