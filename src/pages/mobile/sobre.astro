---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/mobile/Header.astro';
import HorizontalNav from '../../components/mobile/HorizontalNav.astro';
import Footer from '../../components/mobile/Footer.astro';
---

<BaseLayout title="Sonharte | Quem Somos">
  <Header />
  <HorizontalNav />
  
  <main class="flex flex-col gap-10 py-10 px-4 min-h-screen relative overflow-hidden">
    <!-- Decorações de Fundo -->
    <div class="absolute top-20 -left-20 w-72 h-72 rounded-full watercolor-blob"></div>

    <!-- Seção de Cabeçalho -->
    <div class="text-center flex flex-col items-center gap-3 relative z-10">
      <span class="bg-secondary-fixed text-on-secondary-fixed text-[11px] font-label-bold px-3 py-1 border-2 border-black rounded-full shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] -rotate-2 animate-float">
        Nossa essência ✨
      </span>
      <h1 class="font-headline-xl text-3xl text-primary mt-1">Quem Faz a Sonharte?</h1>
      <div class="w-24 h-1.5 bg-primary mt-1 cartoon-border rounded-full"></div>
    </div>

    <!-- História Principal -->
    <div class="flex flex-col gap-8 relative z-10">
      <!-- Foto de destaque da fundadora -->
      <div class="flex justify-center">
        <div class="bg-tertiary-fixed border-4 border-on-surface rounded-3xl p-3 rotate-1 shadow-[5px_5px_0px_0px_rgba(0,0,0,1)] w-full max-w-[280px]">
          <div class="aspect-[4/5] rounded-2xl bg-white border-2 border-on-surface overflow-hidden relative">
            <div class="absolute inset-0 bg-primary-container/10 flex items-center justify-center">
              <span class="material-symbols-outlined text-6xl text-primary-fixed-dim select-none">favorite</span>
            </div>
            <img src="/assets/sobre-photo.jpg" alt="Myllena na Sonharte" class="w-full h-full object-cover relative z-10 opacity-0 transition-opacity duration-300" onload="this.style.opacity='1'" onerror="this.src='data:image/svg+xml;utf8,<svg xmlns=%22http://www.w3.org/2000/svg%22 width=%22100%22 height=%22100%22 viewBox=%220 0 100 100%22><rect width=%22100%25%22 height=%22100%25%22 fill=%22%23ffd9e4%22/><text x=%2250%25%22 y=%2250%25%22 font-family=%22sans-serif%22 font-size=%2210%22 fill=%22%238f0051%22 dominant-baseline=%22middle%22 text-anchor=%22middle%22>Feito com Amor 🌸</text></svg>'" />
          </div>
          <div class="text-center mt-3">
            <span class="font-label-bold text-on-tertiary-fixed text-xs">Myllena — Fundadora & Artesã</span>
          </div>
        </div>
      </div>

      <!-- Texto descritivo -->
      <div class="bg-white p-6 border-4 border-on-surface rounded-2xl shadow-[4px_4px_0px_0px_rgba(75,37,187,1)] -rotate-1">
        <h2 class="font-headline-md text-lg text-primary mb-3">Quem somos?</h2>
        <p class="font-body-md text-on-surface-variant text-sm leading-relaxed mb-3">
          Nosso objetivo é dar vida aos seus sonhos através de personalizados criativos e encantadores, perfeitos para festas, eventos e lembranças inesquecíveis. Cada projeto é desenvolvido com dedicação para refletir a sua personalidade e tornar sua celebração única.
        </p>
        <p class="font-body-md text-on-surface-variant text-sm leading-relaxed">
          Na Sonharte Personalizados, transformamos ideias em mimos reais, criando peças únicas que tornam cada momento ainda mais especial. Trabalhamos com topper de bolo, adesivos, caixinhas personalizadas e diversos itens feitos com carinho e atenção aos detalhes.
        </p>
      </div>
    </div>

    <!-- Valores da Marca -->
    <div class="flex flex-col gap-6 relative z-10">
      <h2 class="font-headline-lg text-2xl text-on-surface text-center">Nossos Valores</h2>
      
      <!-- Valor 1 -->
      <div class="bg-white p-5 border-4 border-on-surface rounded-xl shadow-[3px_3px_0px_0px_rgba(0,0,0,1)] flex flex-col gap-2">
        <div class="w-10 h-10 bg-primary-fixed text-primary rounded-lg border-2 border-black flex items-center justify-center font-bold">
          <span class="material-symbols-outlined text-sm">favorite</span>
        </div>
        <h3 class="font-headline-md text-md text-on-surface">Amor em cada detalhe</h3>
        <p class="font-body-md text-on-surface-variant text-xs leading-relaxed">
          Desde a embalagem cheirosa até a seleção minuciosa dos produtos, cada entrega é enviada como um presente repleto de carinho.
        </p>
      </div>

      <!-- Valor 2 -->
      <div class="bg-white p-5 border-4 border-on-surface rounded-xl shadow-[3px_3px_0px_0px_rgba(0,0,0,1)] flex flex-col gap-2">
        <div class="w-10 h-10 bg-tertiary-fixed text-tertiary rounded-lg border-2 border-black flex items-center justify-center font-bold">
          <span class="material-symbols-outlined text-sm">draw</span>
        </div>
        <h3 class="font-headline-md text-md text-on-surface">Criatividade Sem Limites</h3>
        <p class="font-body-md text-on-surface-variant text-xs leading-relaxed">
          Nossos personalizados são desenhados para expressar a personalidade única de cada cliente, tornando a escrita e o estudo prazerosos.
        </p>
      </div>

      <!-- Valor 3 -->
      <div class="bg-white p-5 border-4 border-on-surface rounded-xl shadow-[3px_3px_0px_0px_rgba(0,0,0,1)] flex flex-col gap-2">
        <div class="w-10 h-10 bg-secondary-fixed text-on-secondary-fixed rounded-lg border-2 border-black flex items-center justify-center font-bold">
          <span class="material-symbols-outlined text-sm">diversity_1</span>
        </div>
        <h3 class="font-headline-md text-md text-on-surface">Atendimento Próximo</h3>
        <p class="font-body-md text-on-surface-variant text-xs leading-relaxed">
          A venda só termina quando você está 100% satisfeito. O suporte direto via WhatsApp garante a você a melhor experiência e segurança.
        </p>
      </div>
    </div>

    <!-- Call to Action -->
    <div class="bg-primary-container text-white border-4 border-on-surface rounded-2xl p-6 text-center flex flex-col items-center gap-4 shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] relative z-10 rotate-1">
      <h2 class="font-headline-lg text-xl">Pronto para sonhar com a gente?</h2>
      <p class="font-body-md text-primary-fixed text-xs">
        Explore nosso catálogo de mimos e envie sua sacola no WhatsApp!
      </p>
      <a href="/mobile/catalogo" class="w-full bg-secondary-fixed text-on-secondary-fixed py-3 border-2 border-black rounded-lg font-label-bold shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] active:translate-x-0.5 active:translate-y-0.5 active:shadow-none text-center text-sm">
        Ver Todos os Mimos 🚀
      </a>
    </div>

  </main>

  <Footer />
</BaseLayout>
