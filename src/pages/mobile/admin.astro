---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/mobile/Header.astro';
import HorizontalNav from '../../components/mobile/HorizontalNav.astro';
import Footer from '../../components/mobile/Footer.astro';
---

<BaseLayout title="Sonharte | Painel ADM">
  <Header />
  <HorizontalNav />
  
  <main class="flex flex-col gap-8 py-10 px-4 min-h-screen relative overflow-hidden">
    <!-- Decorações de Fundo -->
    <div class="absolute top-20 -right-20 w-72 h-72 rounded-full watercolor-blob" style="background: radial-gradient(circle, rgba(230,222,255,0.3) 0%, rgba(252,248,249,0) 70%);"></div>

    <!-- TELA DE LOGIN MOBILE -->
    <div id="login-container" class="w-full relative z-10 my-4">
      <form id="login-form" class="bg-white p-6 border-4 border-on-surface rounded-2xl shadow-[4px_4px_0px_0px_rgba(75,37,187,1)] flex flex-col gap-5">
        <div class="text-center flex flex-col items-center">
          <span class="bg-secondary-fixed text-on-secondary-fixed text-[10px] font-label-bold px-3 py-1 border-2 border-black rounded-full shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] -rotate-1">
            Restrito ADM 🔐
          </span>
          <h2 class="font-headline-md text-xl text-primary mt-2">Painel de Acesso</h2>
        </div>

        <div id="login-error" class="hidden bg-red-100 text-red-700 p-2.5 border-2 border-red-700 rounded-lg font-body-md text-xs">
          Erro ao fazer login. Verifique suas credenciais.
        </div>

        <div class="flex flex-col gap-1">
          <label for="login-email" class="font-label-bold text-xs text-on-surface">E-mail</label>
          <input 
            type="email" 
            id="login-email" 
            required
            placeholder="admin@sonharte.com" 
            class="w-full px-3 py-2.5 border-2 border-on-surface rounded-lg focus:outline-none focus:border-primary text-xs font-body-md bg-background"
          />
        </div>

        <div class="flex flex-col gap-1">
          <label for="login-password" class="font-label-bold text-xs text-on-surface">Senha</label>
          <input 
            type="password" 
            id="login-password" 
            required
            placeholder="••••••••" 
            class="w-full px-3 py-2.5 border-2 border-on-surface rounded-lg focus:outline-none focus:border-primary text-xs font-body-md bg-background"
          />
        </div>

        <button 
          type="submit" 
          class="w-full bg-primary text-white py-3 border-2 border-black rounded-lg font-label-bold shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] active:translate-x-0.5 active:translate-y-0.5 active:shadow-none text-xs"
        >
          Entrar no Painel 🚀
        </button>
      </form>
    </div>

    <!-- PAINEL OPERACIONAL MOBILE -->
    <div id="admin-dashboard" class="hidden flex flex-col gap-6 relative z-10">
      
      <!-- Cabeçalho do Admin -->
      <div class="bg-white p-4 border-4 border-on-surface rounded-2xl shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] flex justify-between items-center">
        <div>
          <span class="text-[10px] text-on-surface-variant font-label-bold">Painel Mobile</span>
          <h2 class="font-headline-md text-lg text-primary" id="admin-welcome">Olá, Myllena! 🌸</h2>
        </div>
        <button 
          id="logout-btn" 
          class="bg-red-100 text-red-700 px-3 py-1.5 border-2 border-red-700 rounded-lg font-label-bold text-[10px] hover:bg-red-200 transition-colors shadow-[1px_1px_0px_0px_rgba(186,26,26,1)] active:translate-x-0.5 active:translate-y-0.5"
        >
          Sair
        </button>
      </div>

      <!-- Abas Mobile -->
      <div class="flex border-b-2 border-on-surface pb-0.5 gap-2">
        <button id="tab-products-btn" class="flex-1 py-2 font-label-bold text-xs bg-white border-x-2 border-t-2 border-on-surface rounded-t-lg translate-y-[3px] z-10 shadow-[0px_-2px_0px_0px_rgba(0,0,0,1)] transition-all">
          Produtos
        </button>
        <button id="tab-services-btn" class="flex-1 py-2 font-label-bold text-xs text-on-surface-variant hover:text-primary transition-all">
          Serviços
        </button>
        <button id="tab-feedbacks-btn" class="flex-1 py-2 font-label-bold text-xs text-on-surface-variant hover:text-primary transition-all">
          Depoimentos
        </button>
      </div>

      <!-- SEÇÃO 1: GERENCIAR PRODUTOS MOBILE -->
      <div id="section-products" class="flex flex-col gap-6">
        
        <!-- Toggle para Mostrar/Ocultar Formulário -->
        <button 
          id="toggle-form-btn" 
          class="w-full bg-secondary-fixed text-on-secondary-fixed py-3 border-2 border-black rounded-lg font-label-bold shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] active:translate-x-0.5 active:translate-y-0.5 active:shadow-none text-xs flex items-center justify-center gap-1"
        >
          <span class="material-symbols-outlined text-sm" id="toggle-form-icon">add</span>
          <span id="toggle-form-text">Adicionar Produto</span>
        </button>

        <!-- Formulário (Oculto por padrão no mobile) -->
        <div id="product-form-wrapper" class="hidden">
          <form id="product-form" class="bg-white p-5 border-4 border-on-surface rounded-2xl shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] flex flex-col gap-3.5">
            <h3 class="font-headline-md text-md text-primary border-b-2 border-dashed border-primary-container pb-1.5" id="form-title">Adicionar Novo Produto</h3>
            <input type="hidden" id="prod-id" />

            <div class="flex flex-col gap-1">
              <label for="prod-titulo" class="font-label-bold text-[10px] text-on-surface">Título do Produto</label>
              <input type="text" id="prod-titulo" required class="w-full px-2.5 py-2 border-2 border-on-surface rounded-lg text-xs font-body-md bg-background" placeholder="Planner Bloom 2025" />
            </div>

            <div class="flex flex-col gap-1">
              <label for="prod-preco" class="font-label-bold text-[10px] text-on-surface">Preço (R$)</label>
              <input type="number" step="0.01" id="prod-preco" required class="w-full px-2.5 py-2 border-2 border-on-surface rounded-lg text-xs font-body-md bg-background" placeholder="89.90" />
            </div>

            <div class="flex flex-col gap-1">
              <label for="prod-categoria" class="font-label-bold text-[10px] text-on-surface">Categoria</label>
              <select id="prod-categoria" required class="w-full px-2.5 py-2 border-2 border-on-surface rounded-lg text-xs font-body-md bg-background">
                <option value="Lápis de Cor">Lápis de Cor</option>
                <option value="Cadernos">Cadernos</option>
                <option value="Canetas">Canetas</option>
                <option value="Presentes Criativos">Presentes Criativos</option>
                <option value="Materiais">Materiais</option>
              </select>
            </div>

            <div class="flex flex-col gap-1">
              <label for="prod-destaque" class="font-label-bold text-[10px] text-on-surface">Selo de Destaque</label>
              <select id="prod-destaque" class="w-full px-2.5 py-2 border-2 border-on-surface rounded-lg text-xs font-body-md bg-background">
                <option value="">Nenhum</option>
                <option value="Lançamento">Lançamento 🚀</option>
                <option value="Mais Vendido">Mais Vendido 🔥</option>
                <option value="Destaque">Destaque ✨</option>
              </select>
            </div>

            <div class="flex flex-col gap-1">
              <label for="prod-imagem-file" class="font-label-bold text-[10px] text-on-surface">Imagem do Produto (Anexo)</label>
              <input type="file" id="prod-imagem-file" accept="image/*" class="w-full px-2.5 py-2 border-2 border-on-surface rounded-lg text-xs font-body-md bg-background cursor-pointer" />
              <input type="hidden" id="prod-imagem" required />
              <div id="prod-imagem-preview-container" class="hidden mt-2 border-2 border-dashed border-on-surface rounded-lg p-1.5 flex items-center justify-center bg-surface-container-low">
                <img id="prod-imagem-preview" src="" alt="Preview" class="max-h-24 object-contain rounded-lg border border-black shadow-[1px_1px_0px_0px_rgba(0,0,0,1)]" />
              </div>
            </div>

            <div class="flex flex-col gap-1">
              <label for="prod-descricao" class="font-label-bold text-[10px] text-on-surface">Descrição Curta</label>
              <textarea id="prod-descricao" required rows="2" class="w-full px-2.5 py-2 border-2 border-on-surface rounded-lg text-xs font-body-md bg-background resize-none" placeholder="Escreva os detalhes..."></textarea>
            </div>

            <div class="flex items-center gap-2 py-1">
              <input type="checkbox" id="prod-ativo" checked class="w-4 h-4 accent-primary" />
              <label for="prod-ativo" class="font-label-bold text-[11px] text-on-surface">Produto ativo</label>
            </div>

            <div class="flex gap-2">
              <button type="submit" class="flex-1 bg-primary text-white py-2.5 border-2 border-black rounded-lg font-label-bold shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] active:translate-x-0.5 active:translate-y-0.5 active:shadow-none text-xs">
                Salvar Produto 💾
              </button>
              <button type="button" id="cancel-edit-btn" class="hidden px-3 bg-surface-container border-2 border-black rounded-lg font-label-bold text-xs hover:bg-surface-dim transition-colors active:translate-x-0.5 active:translate-y-0.5">
                Cancelar
              </button>
            </div>
          </form>
        </div>

        <!-- Lista de Produtos Mobile -->
        <div class="bg-white p-4 border-4 border-on-surface rounded-2xl shadow-[4px_4px_0px_0px_rgba(0,0,0,1)]">
          <h3 class="font-headline-md text-md text-on-surface mb-3 flex items-center justify-between">
            Produtos Cadastrados
            <span class="text-xs bg-primary-fixed text-on-primary-fixed border border-black px-2 py-0.5 rounded" id="products-count-badge">0</span>
          </h3>

          <!-- Barra de Pesquisa de Produtos Mobile -->
          <div class="mb-3 relative">
            <span class="material-symbols-outlined absolute left-2.5 top-1/2 -translate-y-1/2 text-on-surface-variant text-base">search</span>
            <input 
              type="text" 
              id="search-products-input" 
              class="w-full pl-8 pr-3 py-1.5 border-2 border-on-surface rounded-lg text-xs font-body-md bg-background focus:outline-none focus:border-primary transition-colors" 
              placeholder="Pesquisar produto pelo nome..."
            />
          </div>

          <div class="flex flex-col gap-3" id="products-list-container">
            <!-- Injetado dinamicamente -->
          </div>
        </div>

      </div>

      <!-- SEÇÃO 3: GERENCIAR SERVIÇOS MOBILE -->
      <div id="section-services" class="hidden flex flex-col gap-6">
        
        <!-- Toggle para Mostrar/Ocultar Formulário de Serviços -->
        <button 
          id="toggle-serv-form-btn" 
          class="w-full bg-secondary-fixed text-on-secondary-fixed py-3 border-2 border-black rounded-lg font-label-bold shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] active:translate-x-0.5 active:translate-y-0.5 active:shadow-none text-xs flex items-center justify-center gap-1"
        >
          <span class="material-symbols-outlined text-sm" id="toggle-serv-form-icon">add</span>
          <span id="toggle-serv-form-text">Adicionar Serviço</span>
        </button>

        <!-- Formulário (Oculto por padrão no mobile) -->
        <div id="service-form-wrapper" class="hidden">
          <form id="service-form" class="bg-white p-5 border-4 border-on-surface rounded-2xl shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] flex flex-col gap-3.5">
            <h3 class="font-headline-md text-md text-primary border-b-2 border-dashed border-primary-container pb-1.5" id="serv-form-title">Adicionar Novo Serviço</h3>
            <input type="hidden" id="serv-id" />

            <div class="flex flex-col gap-1">
              <label for="serv-titulo" class="font-label-bold text-[10px] text-on-surface">Título do Serviço</label>
              <input type="text" id="serv-titulo" required class="w-full px-2.5 py-2 border-2 border-on-surface rounded-lg text-xs font-body-md bg-background" placeholder="Ex: A4 Colorido (Impressão)" />
            </div>

            <div class="flex flex-col gap-1">
              <label for="serv-descricao" class="font-label-bold text-[10px] text-on-surface">Descrição / Tipo de Papel</label>
              <input type="text" id="serv-descricao" required class="w-full px-2.5 py-2 border-2 border-on-surface rounded-lg text-xs font-body-md bg-background" placeholder="Ex: Papel Sulfite 75g" />
            </div>

            <div class="flex flex-col gap-1">
              <label for="serv-preco" class="font-label-bold text-[10px] text-on-surface">Preço Unitário (R$)</label>
              <input type="number" step="0.01" id="serv-preco" required class="w-full px-2.5 py-2 border-2 border-on-surface rounded-lg text-xs font-body-md bg-background" placeholder="Ex: 2.00" />
            </div>

            <div class="flex gap-2 mt-2">
              <button type="submit" class="flex-1 bg-primary text-white py-3 border-2 border-black rounded-lg font-label-bold shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] active:translate-x-0.5 active:translate-y-0.5 text-xs">
                Salvar Serviço 💾
              </button>
              <button type="button" id="cancel-serv-edit-btn" class="hidden px-3 bg-surface-container border-2 border-black rounded-lg font-label-bold text-xs hover:bg-surface-dim transition-colors active:translate-x-0.5 active:translate-y-0.5">
                Cancelar
              </button>
            </div>
          </form>
        </div>

        <!-- Lista de Serviços Mobile -->
        <div class="bg-white p-4 border-4 border-on-surface rounded-2xl shadow-[4px_4px_0px_0px_rgba(0,0,0,1)]">
          <h3 class="font-headline-md text-md text-on-surface mb-4 flex justify-between items-center">
            Serviços Cadastrados
            <span class="text-xs bg-primary-fixed text-on-primary-fixed border border-black px-2 py-0.5 rounded" id="services-count-badge">0</span>
          </h3>

          <div class="flex flex-col gap-3" id="admin-services-list-container">
            <!-- Injetado dinamicamente -->
          </div>
        </div>

      </div>

      <!-- SEÇÃO 2: MODERAR DEPOIMENTOS MOBILE -->
      <div id="section-feedbacks" class="hidden bg-white p-4 border-4 border-on-surface rounded-2xl shadow-[4px_4px_0px_0px_rgba(0,0,0,1)]">
        <h3 class="font-headline-md text-md text-on-surface mb-4 flex justify-between items-center">
          Depoimentos
          <span class="text-xs bg-tertiary-fixed text-on-tertiary-fixed border border-black px-2 py-0.5 rounded" id="feedbacks-count-badge">0</span>
        </h3>
        
        <div class="flex flex-col gap-4" id="feedbacks-list-container">
          <!-- Injetado dinamicamente -->
        </div>
      </div>

    </div>

  </main>
  
  <Footer />
</BaseLayout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    // Referências do DOM
    const loginContainer = document.getElementById('login-container');
    const dashboard = document.getElementById('admin-dashboard');
    const loginForm = document.getElementById('login-form');
    const loginError = document.getElementById('login-error');
    const logoutBtn = document.getElementById('logout-btn');

    const tabProducts = document.getElementById('tab-products-btn');
    const tabServices = document.getElementById('tab-services-btn');
    const tabFeedbacks = document.getElementById('tab-feedbacks-btn');
    const sectionProducts = document.getElementById('section-products');
    const sectionServices = document.getElementById('section-services');
    const sectionFeedbacks = document.getElementById('section-feedbacks');

    const toggleFormBtn = document.getElementById('toggle-form-btn');
    const productFormWrapper = document.getElementById('product-form-wrapper');
    const toggleFormIcon = document.getElementById('toggle-form-icon');
    const toggleFormText = document.getElementById('toggle-form-text');

    const toggleServFormBtn = document.getElementById('toggle-serv-form-btn');
    const serviceFormWrapper = document.getElementById('service-form-wrapper');
    const toggleServFormIcon = document.getElementById('toggle-serv-form-icon');
    const toggleServFormText = document.getElementById('toggle-serv-form-text');

    const productForm = document.getElementById('product-form');
    const formTitle = document.getElementById('form-title');
    const cancelEditBtn = document.getElementById('cancel-edit-btn');

    const serviceForm = document.getElementById('service-form');
    const servFormTitle = document.getElementById('serv-form-title');
    const cancelServEditBtn = document.getElementById('cancel-serv-edit-btn');

    // Inputs do form de serviços
    const servId = document.getElementById('serv-id');
    const servTitulo = document.getElementById('serv-titulo');
    const servDescricao = document.getElementById('serv-descricao');
    const servPreco = document.getElementById('serv-preco');
    
    // Inputs do form
    const prodId = document.getElementById('prod-id');
    const prodTitulo = document.getElementById('prod-titulo');
    const prodPreco = document.getElementById('prod-preco');
    const prodCategoria = document.getElementById('prod-categoria');
    const prodDestaque = document.getElementById('prod-destaque');
    const prodImagem = document.getElementById('prod-imagem');
    const prodDescricao = document.getElementById('prod-descricao');
    const prodAtivo = document.getElementById('prod-ativo');

    // Inputs adicionais para anexo de imagem mobile
    const prodImagemFile = document.getElementById('prod-imagem-file');
    const previewContainer = document.getElementById('prod-imagem-preview-container');
    const previewImage = document.getElementById('prod-imagem-preview');

    if (prodImagemFile) {
      prodImagemFile.addEventListener('change', (e) => {
        const file = e.target.files[0];
        if (file) {
          const reader = new FileReader();
          reader.onload = (event) => {
            prodImagem.value = event.target.result;
            if (previewImage) previewImage.src = event.target.result;
            if (previewContainer) previewContainer.classList.remove('hidden');
          };
          reader.readAsDataURL(file);
        } else {
          if (!prodId.value) {
            prodImagem.value = '';
            if (previewContainer) previewContainer.classList.add('hidden');
            if (previewImage) previewImage.src = '';
          }
        }
      });
    }

    // Inicializador
    checkAuth();

    // Mostrar/Ocultar Formulário Mobile
    if (toggleFormBtn && productFormWrapper) {
      toggleFormBtn.addEventListener('click', () => {
        const isHidden = productFormWrapper.classList.contains('hidden');
        const isEditMode = prodId.value !== '';
        
        if (isHidden) {
          if (isEditMode) {
            resetProductForm(false);
          }
          productFormWrapper.classList.remove('hidden');
          toggleFormIcon.textContent = 'close';
          toggleFormText.textContent = 'Fechar Formulário';
          toggleFormBtn.className = "w-full bg-surface-container text-on-surface py-3 border-2 border-black rounded-lg font-label-bold shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] active:translate-x-0.5 active:translate-y-0.5 active:shadow-none text-xs flex items-center justify-center gap-1";
        } else {
          if (isEditMode) {
            resetProductForm(false);
          } else {
            closeFormDrawer();
          }
        }
      });
    }

    if (toggleServFormBtn && serviceFormWrapper) {
      toggleServFormBtn.addEventListener('click', () => {
        const isHidden = serviceFormWrapper.classList.contains('hidden');
        const isEditMode = servId.value !== '';
        
        if (isHidden) {
          if (isEditMode) {
            resetServiceForm(false);
          }
          serviceFormWrapper.classList.remove('hidden');
          toggleServFormIcon.textContent = 'close';
          toggleServFormText.textContent = 'Fechar Formulário';
          toggleServFormBtn.className = "w-full bg-surface-container text-on-surface py-3 border-2 border-black rounded-lg font-label-bold shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] active:translate-x-0.5 active:translate-y-0.5 active:shadow-none text-xs flex items-center justify-center gap-1";
        } else {
          if (isEditMode) {
            resetServiceForm(false);
          } else {
            closeServFormDrawer();
          }
        }
      });
    }

    function closeServFormDrawer() {
      serviceFormWrapper.classList.add('hidden');
      toggleServFormIcon.textContent = 'add';
      toggleServFormText.textContent = 'Adicionar Serviço';
      toggleServFormBtn.className = "w-full bg-secondary-fixed text-on-secondary-fixed py-3 border-2 border-black rounded-lg font-label-bold shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] active:translate-x-0.5 active:translate-y-0.5 active:shadow-none text-xs flex items-center justify-center gap-1";
    }

    function closeFormDrawer() {
      productFormWrapper.classList.add('hidden');
      toggleFormIcon.textContent = 'add';
      toggleFormText.textContent = 'Adicionar Produto';
      toggleFormBtn.className = "w-full bg-secondary-fixed text-on-secondary-fixed py-3 border-2 border-black rounded-lg font-label-bold shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] active:translate-x-0.5 active:translate-y-0.5 active:shadow-none text-xs flex items-center justify-center gap-1";
    }

    // 1. Verificação de Autenticação
    async function checkAuth() {
      const user = await window.SonharteDB.getCurrentUser();
      if (user) {
        loginContainer.classList.add('hidden');
        dashboard.classList.remove('hidden');
        loadProducts();
        loadServices();
        loadFeedbacks();
      } else {
        dashboard.classList.add('hidden');
        loginContainer.classList.remove('hidden');
      }
    }

    // Formulário de Login
    if (loginForm) {
      loginForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        loginError.classList.add('hidden');
        const email = document.getElementById('login-email').value;
        const pass = document.getElementById('login-password').value;

        try {
          await window.SonharteDB.login(email, pass);
          checkAuth();
        } catch (err) {
          loginError.textContent = err.message || 'Erro ao realizar login.';
          loginError.classList.remove('hidden');
        }
      });
    }

    // Logout
    if (logoutBtn) {
      logoutBtn.addEventListener('click', () => {
        window.SonharteDB.logout();
        checkAuth();
      });
    }

    // 2. Abas do Dashboard
    if (tabProducts && tabServices && tabFeedbacks) {
      tabProducts.addEventListener('click', () => {
        tabProducts.className = "flex-1 py-2 font-label-bold text-xs bg-white border-x-2 border-t-2 border-on-surface rounded-t-lg translate-y-[3px] z-10 shadow-[0px_-2px_0px_0px_rgba(0,0,0,1)] transition-all";
        tabServices.className = "flex-1 py-2 font-label-bold text-xs text-on-surface-variant hover:text-primary transition-all";
        tabFeedbacks.className = "flex-1 py-2 font-label-bold text-xs text-on-surface-variant hover:text-primary transition-all";
        sectionProducts.classList.remove('hidden');
        sectionServices.classList.add('hidden');
        sectionFeedbacks.classList.add('hidden');
      });

      tabServices.addEventListener('click', () => {
        tabServices.className = "flex-1 py-2 font-label-bold text-xs bg-white border-x-2 border-t-2 border-on-surface rounded-t-lg translate-y-[3px] z-10 shadow-[0px_-2px_0px_0px_rgba(0,0,0,1)] transition-all";
        tabProducts.className = "flex-1 py-2 font-label-bold text-xs text-on-surface-variant hover:text-primary transition-all";
        tabFeedbacks.className = "flex-1 py-2 font-label-bold text-xs text-on-surface-variant hover:text-primary transition-all";
        sectionServices.classList.remove('hidden');
        sectionProducts.classList.add('hidden');
        sectionFeedbacks.classList.add('hidden');
        resetServiceForm();
      });

      tabFeedbacks.addEventListener('click', () => {
        tabFeedbacks.className = "flex-1 py-2 font-label-bold text-xs bg-white border-x-2 border-t-2 border-on-surface rounded-t-lg translate-y-[3px] z-10 shadow-[0px_-2px_0px_0px_rgba(0,0,0,1)] transition-all";
        tabProducts.className = "flex-1 py-2 font-label-bold text-xs text-on-surface-variant hover:text-primary transition-all";
        tabServices.className = "flex-1 py-2 font-label-bold text-xs text-on-surface-variant hover:text-primary transition-all";
        sectionFeedbacks.classList.remove('hidden');
        sectionProducts.classList.add('hidden');
        sectionServices.classList.add('hidden');
      });
    }

    // 3. Gerenciamento de Produtos
    let productsList = [];

    // Barra de pesquisa de produtos mobile
    const searchInput = document.getElementById('search-products-input');
    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        const query = e.target.value.toLowerCase().trim();
        const filtered = productsList.filter(p => 
          p.titulo.toLowerCase().includes(query) || 
          (p.categoria && p.categoria.toLowerCase().includes(query))
        );
        displayProducts(filtered);
      });
    }

    async function loadProducts() {
      try {
        productsList = await window.SonharteDB.getProducts();
        
        // Limpa a barra de pesquisa ao recarregar a lista do banco
        if (searchInput) searchInput.value = '';
        
        displayProducts(productsList);
      } catch (err) {
        const listContainer = document.getElementById('products-list-container');
        if (listContainer) {
          listContainer.innerHTML = '<p class="text-xs text-red-700 text-center py-6">Erro ao carregar lista de produtos.</p>';
        }
      }
    }

    function displayProducts(list) {
      const listContainer = document.getElementById('products-list-container');
      const badge = document.getElementById('products-count-badge');
      if (!listContainer) return;

      badge.textContent = list.length;

      if (list.length === 0) {
        listContainer.innerHTML = '<p class="text-xs text-on-surface-variant text-center py-6">Nenhum produto encontrado.</p>';
        return;
      }

      let html = '';
      list.forEach(p => {
        const preco = typeof p.preco === 'number' ? p.preco : parseFloat(p.preco || 0);
        html += `
          <div class="flex items-center justify-between p-2.5 border-2 border-black rounded-xl bg-surface-container-low hover:bg-white transition-colors gap-3">
            <div class="flex items-center gap-2.5 min-w-0">
              <img src="${p.imagem}" alt="${p.titulo}" class="w-10 h-10 object-cover border-2 border-black rounded-lg bg-surface-variant shrink-0" />
              <div class="min-w-0">
                <h4 class="font-label-bold text-xs text-on-surface truncate" title="${p.titulo}">${p.titulo}</h4>
                <p class="font-body-md text-[9px] text-on-surface-variant">R$ ${preco.toFixed(2).replace('.', ',')} • ${p.ativo ? 'Ativo' : 'Pausado'} ${p.destaque ? `• Selo: ${p.destaque}` : ''}</p>
              </div>
            </div>
            <div class="flex items-center gap-2 shrink-0">
              <button 
                class="edit-prod-btn material-symbols-outlined text-[15px] p-1.5 bg-secondary-fixed text-on-secondary-fixed border-2 border-black rounded-lg shadow-[1px_1px_0px_0px_rgba(0,0,0,1)]"
                data-id="${p.id}"
              >
                edit
              </button>
              <button 
                class="delete-prod-btn material-symbols-outlined text-[15px] p-1.5 bg-red-100 text-red-700 border-2 border-red-700 rounded-lg shadow-[1px_1px_0px_0px_rgba(186,26,26,1)]"
                data-id="${p.id}"
              >
                delete
              </button>
            </div>
          </div>
        `;
      });
      listContainer.innerHTML = html;
      setupProductListEvents();
    }

    function setupProductListEvents() {
      // Editar
      const editBtns = document.querySelectorAll('.edit-prod-btn');
      editBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          const id = btn.getAttribute('data-id');
          const product = productsList.find(p => p.id == id);
          if (product) {
            prodId.value = product.id;
            prodTitulo.value = product.titulo;
            prodPreco.value = product.preco;
            prodCategoria.value = product.categoria;
            if (prodDestaque) prodDestaque.value = product.destaque || '';
            prodImagem.value = product.imagem;
            prodDescricao.value = product.descricao;
            prodAtivo.checked = product.ativo !== false;

            if (previewContainer && previewImage) {
              previewImage.src = product.imagem;
              previewContainer.classList.remove('hidden');
            }

            formTitle.textContent = "Editar Produto";
            cancelEditBtn.classList.remove('hidden');
            
            // Força abertura do formulário
            productFormWrapper.classList.remove('hidden');
            toggleFormIcon.textContent = 'close';
            toggleFormText.textContent = 'Fechar Formulário';
            toggleFormBtn.className = "w-full bg-surface-container text-on-surface py-3 border-2 border-black rounded-lg font-label-bold shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] active:translate-x-0.5 active:translate-y-0.5 active:shadow-none text-xs flex items-center justify-center gap-1";
            
            productFormWrapper.scrollIntoView({ behavior: 'smooth' });
          }
        });
      });

      // Excluir
      const deleteBtns = document.querySelectorAll('.delete-prod-btn');
      deleteBtns.forEach(btn => {
        btn.addEventListener('click', async () => {
          const id = btn.getAttribute('data-id');
          if (confirm('Deseja deletar este produto?')) {
            try {
              await window.SonharteDB.deleteProduct(id);
              loadProducts();
            } catch (err) {
              alert('Erro ao excluir: ' + err.message);
            }
          }
        });
      });
    }

    // Cancelar
    if (cancelEditBtn) {
      cancelEditBtn.addEventListener('click', () => {
        resetProductForm();
      });
    }

    function resetProductForm(shouldCloseDrawer = true) {
      productForm.reset();
      prodId.value = '';
      prodImagem.value = '';
      if (prodDestaque) prodDestaque.value = '';
      if (previewContainer && previewImage) {
        previewContainer.classList.add('hidden');
        previewImage.src = '';
      }
      formTitle.textContent = "Adicionar Novo Produto";
      cancelEditBtn.classList.add('hidden');
      if (shouldCloseDrawer) {
        closeFormDrawer();
      }
    }

    // Submit de Produto
    if (productForm) {
      productForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        
        const payload = {
          titulo: prodTitulo.value,
          preco: parseFloat(prodPreco.value),
          categoria: prodCategoria.value,
          destaque: prodDestaque ? prodDestaque.value : '',
          imagem: prodImagem.value,
          descricao: prodDescricao.value,
          ativo: prodAtivo.checked
        };

        if (prodId.value) {
          payload.id = prodId.value;
        }

        try {
          await window.SonharteDB.saveProduct(payload);
          resetProductForm();
          loadProducts();
        } catch (err) {
          alert('Erro ao salvar: ' + err.message);
        }
      });
    }

    // 5. Serviços Mobile (CRUD)
    let servicesList = [];

    async function loadServices() {
      const listContainer = document.getElementById('admin-services-list-container');
      const badge = document.getElementById('services-count-badge');
      if (!listContainer) return;

      try {
        servicesList = await window.SonharteDB.getServices();
        badge.textContent = servicesList.length;

        if (servicesList.length === 0) {
          listContainer.innerHTML = '<p class="text-xs text-on-surface-variant text-center py-6">Nenhum serviço cadastrado.</p>';
          return;
        }

        let html = '';
        servicesList.forEach(s => {
          html += `
            <div class="flex items-center justify-between p-3 border-2 border-black rounded-xl bg-surface-container-low hover:bg-white transition-colors gap-3">
              <div>
                <h4 class="font-label-bold text-xs text-on-surface truncate max-w-[170px]" title="${s.titulo}">${s.titulo}</h4>
                <p class="font-body-md text-[9px] text-on-surface-variant">${s.descricao} • R$ ${parseFloat(s.preco).toFixed(2).replace('.', ',')}</p>
              </div>
              <div class="flex items-center gap-2 shrink-0">
                <button 
                  class="edit-serv-btn material-symbols-outlined text-xs p-1.5 bg-secondary-fixed text-on-secondary-fixed border-2 border-black rounded-lg shadow-[1px_1px_0px_0px_rgba(0,0,0,1)]"
                  data-id="${s.id}"
                >
                  edit
                </button>
                <button 
                  class="delete-serv-btn material-symbols-outlined text-xs p-1.5 bg-red-100 text-red-700 border-2 border-red-700 rounded-lg shadow-[1px_1px_0px_0px_rgba(186,26,26,1)]"
                  data-id="${s.id}"
                >
                  delete
                </button>
              </div>
            </div>
          `;
        });
        listContainer.innerHTML = html;
        setupServiceListEvents();
      } catch (err) {
        listContainer.innerHTML = '<p class="text-xs text-red-700 text-center py-6">Erro ao carregar lista de serviços.</p>';
      }
    }

    function setupServiceListEvents() {
      const editBtns = document.querySelectorAll('.edit-serv-btn');
      editBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          const id = btn.getAttribute('data-id');
          const service = servicesList.find(s => s.id === id);
          if (service) {
            servId.value = service.id;
            servTitulo.value = service.titulo;
            servDescricao.value = service.descricao;
            servPreco.value = service.preco;

            servFormTitle.textContent = "Editar Serviço";
            cancelServEditBtn.classList.remove('hidden');
            
            // Força a abertura do formulário
            serviceFormWrapper.classList.remove('hidden');
            toggleServFormIcon.textContent = 'close';
            toggleServFormText.textContent = 'Fechar Formulário';
            toggleServFormBtn.className = "w-full bg-surface-container text-on-surface py-3 border-2 border-black rounded-lg font-label-bold shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] active:translate-x-0.5 active:translate-y-0.5 active:shadow-none text-xs flex items-center justify-center gap-1";

            serviceFormWrapper.scrollIntoView({ behavior: 'smooth' });
          }
        });
      });

      const deleteBtns = document.querySelectorAll('.delete-serv-btn');
      deleteBtns.forEach(btn => {
        btn.addEventListener('click', async () => {
          const id = btn.getAttribute('data-id');
          if (confirm('Deseja deletar este serviço?')) {
            try {
              await window.SonharteDB.deleteService(id);
              loadServices();
            } catch (err) {
              alert('Erro: ' + err.message);
            }
          }
        });
      });
    }

    if (cancelServEditBtn) {
      cancelServEditBtn.addEventListener('click', () => {
        resetServiceForm();
      });
    }

    function resetServiceForm(shouldCloseDrawer = true) {
      serviceForm.reset();
      servId.value = '';
      servFormTitle.textContent = "Adicionar Novo Serviço";
      cancelServEditBtn.classList.add('hidden');
      if (shouldCloseDrawer) {
        closeServFormDrawer();
      }
    }

    if (serviceForm) {
      serviceForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        
        const payload = {
          titulo: servTitulo.value,
          descricao: servDescricao.value,
          preco: parseFloat(servPreco.value)
        };

        if (servId.value) {
          payload.id = servId.value;
        }

        try {
          await window.SonharteDB.saveService(payload);
          resetServiceForm();
          loadServices();
        } catch (err) {
          alert('Erro: ' + err.message);
        }
      });
    }

    // 4. Depoimentos Mobile
    async function loadFeedbacks() {
      const listContainer = document.getElementById('feedbacks-list-container');
      const badge = document.getElementById('feedbacks-count-badge');
      if (!listContainer) return;

      try {
        const feedbacksList = await window.SonharteDB.getFeedbacks();
        badge.textContent = feedbacksList.length;

        if (feedbacksList.length === 0) {
          listContainer.innerHTML = '<p class="text-xs text-on-surface-variant text-center py-6">Nenhum depoimento cadastrado.</p>';
          return;
        }

        let html = '';
        feedbacksList.forEach(f => {
          html += `
            <div class="bg-surface-container-low p-3.5 border-2 border-black rounded-xl flex flex-col justify-between gap-2.5 shadow-[2px_2px_0px_0px_rgba(0,0,0,1)]">
              <div>
                <div class="flex justify-between items-center mb-1.5">
                  <h4 class="font-label-bold text-xs text-on-surface">${f.nome}</h4>
                  <span class="text-[9px] text-on-surface-variant font-label-bold">${f.data || 'Recente'}</span>
                </div>
                <p class="font-body-md text-[11px] text-on-surface-variant leading-relaxed">"${f.texto}"</p>
                <div class="flex text-amber-500 mt-1">
                  ${Array(f.estrelas).fill('<span class="material-symbols-outlined text-[11px]">star</span>').join('')}
                </div>
              </div>
              <button 
                class="delete-feedback-btn w-full bg-red-100 text-red-700 py-1.5 border-2 border-red-700 rounded-lg font-label-bold text-[9px] shadow-[1px_1px_0px_0px_rgba(186,26,26,1)] flex items-center justify-center gap-1 mt-1"
                data-id="${f.id}"
              >
                <span class="material-symbols-outlined text-[10px]">delete</span> Remover
              </button>
            </div>
          `;
        });
        listContainer.innerHTML = html;
        setupFeedbackListEvents();
      } catch (err) {
        listContainer.innerHTML = '<p class="text-xs text-red-700 text-center py-6">Erro ao carregar depoimentos.</p>';
      }
    }

    function setupFeedbackListEvents() {
      const deleteBtns = document.querySelectorAll('.delete-feedback-btn');
      deleteBtns.forEach(btn => {
        btn.addEventListener('click', async () => {
          const id = btn.getAttribute('data-id');
          if (confirm('Deseja realmente remover este depoimento?')) {
            try {
              await window.SonharteDB.deleteFeedback(id);
              loadFeedbacks();
            } catch (err) {
              alert('Erro: ' + err.message);
            }
          }
        });
      });
    }

  });
</script>
