---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/mobile/Header.astro';
import HorizontalNav from '../../components/mobile/HorizontalNav.astro';
import Footer from '../../components/mobile/Footer.astro';
---

<BaseLayout title="Sonharte | Workshops & Personalizados">
  <Header />
  <HorizontalNav />
  
  <main class="flex flex-col gap-10 py-10 px-4 min-h-screen relative overflow-hidden">
    <!-- Decorações de Fundo -->
    <div class="absolute bottom-10 -left-20 w-72 h-72 rounded-full watercolor-blob" style="background: radial-gradient(circle, rgba(230,222,255,0.3) 0%, rgba(252,248,249,0) 70%);"></div>

    <!-- Seção de Cabeçalho -->
    <div class="text-center flex flex-col items-center gap-3 relative z-10">
      <span class="bg-secondary-fixed text-on-secondary-fixed text-[11px] font-label-bold px-3 py-1 border-2 border-black rounded-full shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] -rotate-1 animate-float">
        Tornando momentos inesquecíveis ✨
      </span>
      <h1 class="font-headline-xl text-3xl text-primary mt-1">Workshops & Extras</h1>
      <div class="w-24 h-1.5 bg-primary mt-1 cartoon-border rounded-full"></div>
      <p class="font-body-md text-xs text-on-surface-variant max-w-sm mt-2 leading-relaxed">
        Além da papelaria criativa pronta, damos vida aos seus sonhos através de mimos reais e personalizados sob medida para sua festa, evento ou comemoração.
      </p>
    </div>

    <!-- Lista de Serviços (Mobile - Rolagem Horizontal) -->
    <div class="flex gap-6 overflow-x-auto no-scrollbar scroll-smooth snap-x snap-mandatory relative z-10 py-6 px-[6vw]">
      
      <!-- Serviço 1: Caixinhas Personalizadas -->
      <div class="animate-antigravity-1 w-[290px] shrink-0 snap-start">
        <div class="bg-white border-4 border-on-surface rounded-2xl overflow-hidden shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] flex flex-col h-full">
          <div class="aspect-video w-full border-b-4 border-on-surface overflow-hidden bg-tertiary-fixed/20">
            <img 
              src="/assets/caixinhas_personalizadas.png" 
              alt="Caixinhas Personalizadas" 
              class="w-full h-full object-cover" 
              onerror="this.src='data:image/svg+xml;utf8,<svg xmlns=%22http://www.w3.org/2000/svg%22 width=%22100%22 height=%22100%22><rect width=%22100%25%22 height=%22100%25%22 fill=%22%23ffd9e4%22/><text x=%2250%25%22 y=%2250%25%22 dominant-baseline=%22middle%22 text-anchor=%22middle%22>Caixinhas 🌸</text></svg>'"
            />
          </div>
          <div class="p-5 flex flex-col gap-2 flex-grow">
            <span class="text-[10px] font-label-bold text-tertiary uppercase tracking-wider">Papelaria e Lembrancinhas</span>
            <h3 class="font-headline-md text-lg text-on-surface">Caixinhas Personalizadas</h3>
            <p class="font-body-md text-xs text-on-surface-variant leading-relaxed">
              Caixinhas fofas perfeitas para lembrancinhas de festas infantis, casamentos, batizados e eventos. Feitas sob medida com papéis especiais de alta gramatura e apliques charmosos.
            </p>
          </div>
        </div>
      </div>

      <!-- Serviço 2: Topper de Bolo -->
      <div class="animate-antigravity-2 w-[290px] shrink-0 snap-start">
        <div class="bg-white border-4 border-on-surface rounded-2xl overflow-hidden shadow-[4px_4px_0px_0px_rgba(75,37,187,1)] flex flex-col h-full rotate-1">
          <div class="aspect-video w-full border-b-4 border-on-surface overflow-hidden bg-primary-fixed/20">
            <img 
              src="/assets/topper_bolo.png" 
              alt="Topper de Bolo" 
              class="w-full h-full object-cover"
              onerror="this.src='data:image/svg+xml;utf8,<svg xmlns=%22http://www.w3.org/2000/svg%22 width=%22100%22 height=%22100%22><rect width=%22100%25%22 height=%22100%25%22 fill=%22%23e6deff%22/><text x=%2250%25%22 y=%2250%25%22 dominant-baseline=%22middle%22 text-anchor=%22middle%22>Topper de Bolo 🎂</text></svg>'"
            />
          </div>
          <div class="p-5 flex flex-col gap-2 flex-grow">
            <span class="text-[10px] font-label-bold text-primary uppercase tracking-wider">Topo de Bolo Festivo</span>
            <h3 class="font-headline-md text-lg text-on-surface">Toppers de Bolo</h3>
            <p class="font-body-md text-xs text-on-surface-variant leading-relaxed">
              Toppers de bolo tridimensionais (paper toppers) com camadas de papel colorido, glitter e detalhes incríveis. Personalizados com o tema e nome que você escolher.
            </p>
          </div>
        </div>
      </div>

      <!-- Serviço 3: Adesivos Personalizados -->
      <div class="animate-antigravity-3 w-[290px] shrink-0 snap-start">
        <div class="bg-white border-4 border-on-surface rounded-2xl overflow-hidden shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] flex flex-col h-full -rotate-1">
          <div class="aspect-video w-full border-b-4 border-on-surface overflow-hidden bg-secondary-fixed/20">
            <img 
              src="/assets/adesivos_personalizados.png" 
              alt="Adesivos Personalizados" 
              class="w-full h-full object-cover"
              onerror="this.src='data:image/svg+xml;utf8,<svg xmlns=%22http://www.w3.org/2000/svg%22 width=%22100%22 height=%22100%22><rect width=%22100%25%22 height=%22100%25%22 fill=%22%23ffe16d%22/><text x=%2250%25%22 y=%2250%25%22 dominant-baseline=%22middle%22 text-anchor=%22middle%22>Adesivos 🏷️</text></svg>'"
            />
          </div>
          <div class="p-5 flex flex-col gap-2 flex-grow">
            <span class="text-[10px] font-label-bold text-on-secondary-fixed-variant uppercase tracking-wider">Adesivos & Rótulos</span>
            <h3 class="font-headline-md text-lg text-on-surface">Adesivos Personalizados</h3>
            <p class="font-body-md text-xs text-on-surface-variant leading-relaxed">
              Adesivos em papel fotográfico e vinil de alta qualidade, recortados eletronicamente sob medida. Perfeitos para lembrancinhas de festas infantis, sacolas, identificação de produtos, cardápios e brindes.
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- Seção de Portfólio (Foco Central - Netflix - Mobile) -->
    <div class="flex flex-col gap-4 relative z-10 overflow-hidden">
      <div class="flex flex-col gap-1 mt-2 text-center items-center">
        <h2 class="font-headline-lg text-xl text-on-surface flex items-center gap-2">
          <span class="material-symbols-outlined text-primary text-xl">auto_awesome</span> Portfólio de Sonhos
        </h2>
        <p class="font-body-md text-[11px] text-on-surface-variant">Arraste para o lado para ver alguns dos mimos que já fizemos!</p>
      </div>

      <!-- Carrossel Mobile -->
      <div class="relative w-full">
        <!-- Contêiner de Cards -->
        <div 
          id="portfolio-carousel-mobile"
          class="flex gap-6 overflow-x-auto no-scrollbar scroll-smooth snap-x snap-mandatory py-6 px-[12vw]"
        >
          <!-- Item 1 -->
          <div class="w-[260px] shrink-0 snap-center carousel-item transition-all duration-500 ease-out transform scale-90 opacity-40">
            <div class="bg-white border-4 border-on-surface rounded-2xl overflow-hidden shadow-[3px_3px_0px_0px_rgba(0,0,0,1)]">
              <div class="aspect-square w-full overflow-hidden bg-tertiary-fixed/10 border-b-4 border-on-surface">
                <img src="/assets/portfolio/topper_pix.png" alt="Topper de Bolo Pix" class="w-full h-full object-cover" />
              </div>
              <div class="p-3 bg-tertiary-fixed text-center">
                <span class="font-headline-md text-xs text-on-tertiary-fixed">Topper de Bolo Pix divertido</span>
              </div>
            </div>
          </div>

          <!-- Item 2 -->
          <div class="w-[260px] shrink-0 snap-center carousel-item transition-all duration-500 ease-out transform scale-90 opacity-40">
            <div class="bg-white border-4 border-on-surface rounded-2xl overflow-hidden shadow-[3px_3px_0px_0px_rgba(75,37,187,1)]">
              <div class="aspect-square w-full overflow-hidden bg-primary-fixed/10 border-b-4 border-on-surface">
                <img src="/assets/portfolio/caixinha_concha.png" alt="Caixinha Concha Fundo do Mar" class="w-full h-full object-cover" />
              </div>
              <div class="p-3 bg-primary-fixed text-center">
                <span class="font-headline-md text-xs text-on-primary-fixed">Caixinha Concha Fundo do Mar</span>
              </div>
            </div>
          </div>

          <!-- Item 3 -->
          <div class="w-[260px] shrink-0 snap-center carousel-item transition-all duration-500 ease-out transform scale-90 opacity-40">
            <div class="bg-white border-4 border-on-surface rounded-2xl overflow-hidden shadow-[3px_3px_0px_0px_rgba(0,0,0,1)]">
              <div class="aspect-square w-full overflow-hidden bg-secondary-fixed/10 border-b-4 border-on-surface">
                <img src="/assets/portfolio/adesivos_patrulha.jpg" alt="Adesivos Patrulha Canina" class="w-full h-full object-cover" />
              </div>
              <div class="p-3 bg-secondary-fixed text-center">
                <span class="font-headline-md text-xs text-on-secondary-fixed">Adesivos Patrulha Canina</span>
              </div>
            </div>
          </div>

          <!-- Item 4 -->
          <div class="w-[260px] shrink-0 snap-center carousel-item transition-all duration-500 ease-out transform scale-90 opacity-40">
            <div class="bg-white border-4 border-on-surface rounded-2xl overflow-hidden shadow-[3px_3px_0px_0px_rgba(75,37,187,1)]">
              <div class="aspect-square w-full overflow-hidden bg-primary-fixed/10 border-b-4 border-on-surface">
                <img src="/assets/portfolio/topper_larissa.jpg" alt="Topper de Bolo Larissa 30 Anos" class="w-full h-full object-cover" />
              </div>
              <div class="p-3 bg-primary-fixed text-center">
                <span class="font-headline-md text-xs text-on-primary-fixed">Topper de Bolo Rose Gold</span>
              </div>
            </div>
          </div>

          <!-- Item 5 -->
          <div class="w-[260px] shrink-0 snap-center carousel-item transition-all duration-500 ease-out transform scale-90 opacity-40">
            <div class="bg-white border-4 border-on-surface rounded-2xl overflow-hidden shadow-[3px_3px_0px_0px_rgba(0,0,0,1)]">
              <div class="aspect-square w-full overflow-hidden bg-tertiary-fixed/10 border-b-4 border-on-surface">
                <img src="/assets/portfolio/adesivos_memes.jpg" alt="Adesivos Personalizados Diversos" class="w-full h-full object-cover" />
              </div>
              <div class="p-3 bg-tertiary-fixed text-center">
                <span class="font-headline-md text-xs text-on-tertiary-fixed">Adesivos de Memes & Frases</span>
              </div>
            </div>
          </div>

          <!-- Item 6 -->
          <div class="w-[260px] shrink-0 snap-center carousel-item transition-all duration-500 ease-out transform scale-90 opacity-40">
            <div class="bg-white border-4 border-on-surface rounded-2xl overflow-hidden shadow-[3px_3px_0px_0px_rgba(75,37,187,1)]">
              <div class="aspect-square w-full overflow-hidden bg-secondary-fixed/10 border-b-4 border-on-surface">
                <img src="/assets/portfolio/cardapio_porcoes.jpg" alt="Cardápio Plastificado para Eventos" class="w-full h-full object-cover" />
              </div>
              <div class="p-3 bg-secondary-fixed text-center">
                <span class="font-headline-md text-xs text-on-secondary-fixed">Cardápio de Porções Plastificado</span>
              </div>
            </div>
          </div>

          <!-- Item 7 -->
          <div class="w-[260px] shrink-0 snap-center carousel-item transition-all duration-500 ease-out transform scale-90 opacity-40">
            <div class="bg-white border-4 border-on-surface rounded-2xl overflow-hidden shadow-[3px_3px_0px_0px_rgba(0,0,0,1)]">
              <div class="aspect-square w-full overflow-hidden bg-primary-fixed/10 border-b-4 border-on-surface">
                <img src="/assets/portfolio/topper_40anos.png" alt="Topper de Bolo Dourado Como Assim 40?" class="w-full h-full object-cover" />
              </div>
              <div class="p-3 bg-primary-fixed text-center">
                <span class="font-headline-md text-xs text-on-primary-fixed">Topper de Bolo Dourado 40 anos</span>
              </div>
            </div>
          </div>

          <!-- Item 8 -->
          <div class="w-[260px] shrink-0 snap-center carousel-item transition-all duration-500 ease-out transform scale-90 opacity-40">
            <div class="bg-white border-4 border-on-surface rounded-2xl overflow-hidden shadow-[3px_3px_0px_0px_rgba(75,37,187,1)]">
              <div class="aspect-square w-full overflow-hidden bg-secondary-fixed/10 border-b-4 border-on-surface">
                <img src="/assets/portfolio/caixinha_astronauta_cone.png" alt="Caixinha Cone Astronauta" class="w-full h-full object-cover" />
              </div>
              <div class="p-3 bg-secondary-fixed text-center">
                <span class="font-headline-md text-xs text-on-secondary-fixed">Caixinha Cone Astronauta</span>
              </div>
            </div>
          </div>

          <!-- Item 9 -->
          <div class="w-[260px] shrink-0 snap-center carousel-item transition-all duration-500 ease-out transform scale-90 opacity-40">
            <div class="bg-white border-4 border-on-surface rounded-2xl overflow-hidden shadow-[3px_3px_0px_0px_rgba(0,0,0,1)]">
              <div class="aspect-square w-full overflow-hidden bg-tertiary-fixed/10 border-b-4 border-on-surface">
                <img src="/assets/portfolio/topper_tardezinha.png" alt="Topper de Bolo Tema Tardezinha" class="w-full h-full object-cover" />
              </div>
              <div class="p-3 bg-tertiary-fixed text-center">
                <span class="font-headline-md text-xs text-on-tertiary-fixed">Topper de Bolo Tardezinha</span>
              </div>
            </div>
          </div>

          <!-- Item 10 -->
          <div class="w-[260px] shrink-0 snap-center carousel-item transition-all duration-500 ease-out transform scale-90 opacity-40">
            <div class="bg-white border-4 border-on-surface rounded-2xl overflow-hidden shadow-[3px_3px_0px_0px_rgba(75,37,187,1)]">
              <div class="aspect-square w-full overflow-hidden bg-secondary-fixed/10 border-b-4 border-on-surface">
                <img src="/assets/portfolio/caixinha_incriveis.jpg" alt="Caixinha Lembrancinha Os Incríveis" class="w-full h-full object-cover" />
              </div>
              <div class="p-3 bg-secondary-fixed text-center">
                <span class="font-headline-md text-xs text-on-secondary-fixed">Caixinha Lembrancinha Os Incríveis</span>
              </div>
            </div>
          </div>

          <!-- Item 11 -->
          <div class="w-[260px] shrink-0 snap-center carousel-item transition-all duration-500 ease-out transform scale-90 opacity-40">
            <div class="bg-white border-4 border-on-surface rounded-2xl overflow-hidden shadow-[3px_3px_0px_0px_rgba(0,0,0,1)]">
              <div class="aspect-square w-full overflow-hidden bg-tertiary-fixed/10 border-b-4 border-on-surface">
                <img src="/assets/portfolio/topper_dosrosa.png" alt="Topper de Bolo Infantil Dos Rosa" class="w-full h-full object-cover" />
              </div>
              <div class="p-3 bg-tertiary-fixed text-center">
                <span class="font-headline-md text-xs text-on-tertiary-fixed">Topper Infantil Dos Rosa</span>
              </div>
            </div>
          </div>

          <!-- Item 12 -->
          <div class="w-[260px] shrink-0 snap-center carousel-item transition-all duration-500 ease-out transform scale-90 opacity-40">
            <div class="bg-white border-4 border-on-surface rounded-2xl overflow-hidden shadow-[3px_3px_0px_0px_rgba(75,37,187,1)]">
              <div class="aspect-square w-full overflow-hidden bg-primary-fixed/10 border-b-4 border-on-surface">
                <img src="/assets/portfolio/caixinha_astronauta_alca.png" alt="Caixinha Astronauta com Alça" class="w-full h-full object-cover" />
              </div>
              <div class="p-3 bg-primary-fixed text-center">
                <span class="font-headline-md text-xs text-on-primary-fixed">Caixinha Astronauta com Alça</span>
              </div>
            </div>
          </div>

        </div>
      </div>
    </div>

    <script is:inline>
      document.addEventListener('DOMContentLoaded', () => {
        const carousel = document.getElementById('portfolio-carousel-mobile');
        if (carousel) {
          const cards = carousel.querySelectorAll('.carousel-item');

          function updateActiveCardMobile() {
            const carouselRect = carousel.getBoundingClientRect();
            const carouselCenter = carouselRect.left + carouselRect.width / 2;

            cards.forEach(card => {
              const cardRect = card.getBoundingClientRect();
              const cardCenter = cardRect.left + cardRect.width / 2;
              const distanceFromCenter = Math.abs(carouselCenter - cardCenter);

              // No mobile, a tolerância é de 140px por conta da largura menor do card (260px)
              if (distanceFromCenter < 140) {
                card.classList.remove('opacity-40', 'scale-90');
                card.classList.add('opacity-100', 'scale-105', 'z-10');
              } else {
                card.classList.remove('opacity-100', 'scale-105', 'z-10');
                card.classList.add('opacity-40', 'scale-90');
              }
            });
          }

          carousel.addEventListener('scroll', updateActiveCardMobile);
          window.addEventListener('resize', updateActiveCardMobile);
          setTimeout(updateActiveCardMobile, 300);
        }
      });
    </script>

    <!-- Informações sobre Orçamento / Chat (WhatsApp e Instagram) Mobile -->
    <div class="bg-secondary-fixed text-on-secondary-fixed p-6 border-4 border-on-surface rounded-2xl shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] flex flex-col gap-5 relative z-10">
      <div class="flex flex-col gap-1 text-left">
        <h3 class="font-headline-md text-lg flex items-center gap-2">
          <span class="material-symbols-outlined">chat</span> Valores por Chat
        </h3>
        <p class="font-body-md text-xs leading-relaxed">
          Como os nossos serviços de personalizados são totalmente sob medida, <strong>os valores de cada projeto variam e são combinados de forma individual</strong>. Converse com a gente pelo WhatsApp ou direct para montarmos seu orçamento especial!
        </p>
      </div>
      
      <div class="flex flex-col gap-3">
        <a 
          href="https://wa.me/5531972122639?text=Olá!%20Gostaria%20de%20solicitar%20um%20orçamento%20para%20serviços%20personalizados%20(caixinhas/toppers/adesivos)." 
          target="_blank"
          class="bg-white border-2 border-black rounded-xl py-3 font-label-bold text-xs shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] active:translate-x-0.5 active:translate-y-0.5 active:shadow-none transition-colors text-center text-primary flex items-center justify-center gap-1.5"
        >
          <span class="material-symbols-outlined text-sm">chat</span> Chamar no WhatsApp
        </a>
        
        <a 
          href="https://www.instagram.com/p.sonharte/" 
          target="_blank"
          class="bg-tertiary text-white border-2 border-black rounded-xl py-3 font-label-bold text-xs shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] active:translate-x-0.5 active:translate-y-0.5 active:shadow-none transition-colors text-center flex items-center justify-center gap-1.5"
        >
          <span class="material-symbols-outlined text-sm">photo_camera</span> Instagram Direct
        </a>
      </div>
    </div>
    
  </main>

  <Footer />
</BaseLayout>
