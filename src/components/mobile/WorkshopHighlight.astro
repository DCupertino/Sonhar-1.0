      <p class="font-body-md text-xs text-on-surface-variant max-w-sm mt-1 leading-relaxed">
        Além dos produtos de pronta entrega, somos especialistas em criar **artigos de festa, toppers de bolo e adesivos personalizados 100% sob medida**.
      </p>
    </div>

    <!-- Imagem de Destaque Mobile (Slideshow de Papel Rasgado) -->
    <div class="relative flex justify-center items-center py-2">
      <div class="bg-white p-3 border-4 border-on-surface rounded-2xl shadow-[4px_4px_0px_0px_rgba(75,37,187,1)] w-full max-w-xs relative rotate-1">
        <div class="aspect-square w-full rounded-xl bg-surface-variant overflow-hidden border-2 border-on-surface relative" id="brush-slideshow-container-mobile">
          <img 
            src="/assets/caixinhas_personalizadas.png" 
            alt="Caixinhas Personalizadas" 
            class="brush-slide-mobile absolute inset-0 w-full h-full object-cover transition-all duration-[600ms] opacity-100 scale-100"
            data-caption="Caixinhas Personalizadas 🌸"
          />
          <img 
            src="/assets/topper_bolo.png" 
            alt="Topper de Bolo" 
            class="brush-slide-mobile absolute inset-0 w-full h-full object-cover transition-all duration-[600ms] opacity-0 scale-95"
            data-caption="Toppers de Bolo Decorativos 🎂"
          />
          <img 
            src="/assets/adesivos_personalizados.png" 
            alt="Adesivos Personalizados" 
            class="brush-slide-mobile absolute inset-0 w-full h-full object-cover transition-all duration-[600ms] opacity-0 scale-95"
            data-caption="Adesivos & Rótulos Exclusivos 🏷️"
          />

          <!-- Elemento de Papel Rasgado para Transição Mobile -->
          <div id="paper-wipe-overlay-mobile">
            <div class="paper-body-mobile"></div>
            <!-- Borda Direita -->
            <svg class="paper-edge-mobile edge-right-mobile absolute top-0 bottom-0 -right-4 w-4 h-full opacity-0" viewBox="0 0 20 100" preserveAspectRatio="none">
              <path d="M0,0 L4,3 L1,7 L5,11 L2,15 L6,20 L3,25 L5,31 L1,37 L4,42 L2,48 L6,53 L3,59 L5,64 L1,70 L4,76 L2,81 L6,87 L3,93 L5,98 L0,100 Z" />
            </svg>
            <!-- Borda Esquerda -->
            <svg class="paper-edge-mobile edge-left-mobile absolute top-0 bottom-0 -left-4 w-4 h-full opacity-0 transform rotate-180" viewBox="0 0 20 100" preserveAspectRatio="none">
              <path d="M0,0 L4,3 L1,7 L5,11 L2,15 L6,20 L3,25 L5,31 L1,37 L4,42 L2,48 L6,53 L3,59 L5,64 L1,70 L4,76 L2,81 L6,87 L3,93 L5,98 L0,100 Z" />
            </svg>
            <!-- Borda Inferior -->
            <svg class="paper-edge-mobile edge-bottom-mobile absolute left-0 right-0 -bottom-4 h-4 w-full opacity-0" viewBox="0 0 100 20" preserveAspectRatio="none">
              <path d="M0,0 L3,4 L7,1 L11,5 L15,2 L20,6 L25,3 L31,5 L37,1 L42,4 L48,2 L53,6 L59,3 L64,5 L70,1 L76,4 L81,2 L87,6 L93,3 L98,5 L100,0 Z" />
            </svg>
            <!-- Borda Superior -->
            <svg class="paper-edge-mobile edge-top-mobile absolute left-0 right-0 -top-4 h-4 w-full opacity-0 transform rotate-180" viewBox="0 0 100 20" preserveAspectRatio="none">
              <path d="M0,0 L3,4 L7,1 L11,5 L15,2 L20,6 L25,3 L31,5 L37,1 L42,4 L48,2 L53,6 L59,3 L64,5 L70,1 L76,4 L81,2 L87,6 L93,3 L98,5 L100,0 Z" />
            </svg>
          </div>
        </div>
        <div class="mt-2.5 text-center">
          <span class="font-label-bold text-primary text-xs flex items-center justify-center gap-1.5" id="brush-slide-caption-mobile">
            <span class="material-symbols-outlined text-xs">stars</span> Caixinhas Personalizadas 🌸
          </span>
        </div>
        
        <!-- Balãozinho / Sticker Mobile -->
        <div class="absolute -top-3 -right-2 bg-secondary-fixed text-on-secondary-fixed border-2 border-black px-3 py-1.5 rounded-xl shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] rotate-6 font-label-bold text-[10px] select-none z-20">
          Exclusivo! 🌸
        </div>
      </div>

      <style is:inline>
        #paper-wipe-overlay-mobile {
          position: absolute;
          inset: 0;
          z-index: 30;
          pointer-events: none;
          transform: translateX(105%);
        }
        .paper-body-mobile {
          position: absolute;
          inset: 0;
        }
        .paper-edge-mobile {
          position: absolute;
          pointer-events: none;
          transition: opacity 0.2s ease;
        }

        /* LR (Left to Right) */
        .paper-animate-lr-mobile {
          animation: paper-wipe-lr-anim-mobile 1.2s cubic-bezier(0.77, 0, 0.175, 1) forwards;
        }
        @keyframes paper-wipe-lr-anim-mobile {
          0% { transform: translateX(-105%); }
          45%, 55% { transform: translateX(0%); }
          100% { transform: translateX(105%); }
        }

        /* RL (Right to Left) */
        .paper-animate-rl-mobile {
          animation: paper-wipe-rl-anim-mobile 1.2s cubic-bezier(0.77, 0, 0.175, 1) forwards;
        }
        @keyframes paper-wipe-rl-anim-mobile {
          0% { transform: translateX(105%); }
          45%, 55% { transform: translateX(0%); }
          100% { transform: translateX(-105%); }
        }

        /* TB (Top to Bottom) */
        .paper-animate-tb-mobile {
          animation: paper-wipe-tb-anim-mobile 1.2s cubic-bezier(0.77, 0, 0.175, 1) forwards;
        }
        @keyframes paper-wipe-tb-anim-mobile {
          0% { transform: translateY(-105%); }
          45%, 55% { transform: translateY(0%); }
          100% { transform: translateY(105%); }
        }

        /* BT (Bottom to Top) */
        .paper-animate-bt-mobile {
          animation: paper-wipe-bt-anim-mobile 1.2s cubic-bezier(0.77, 0, 0.175, 1) forwards;
        }
        @keyframes paper-wipe-bt-anim-mobile {
          0% { transform: translateY(105%); }
          45%, 55% { transform: translateY(0%); }
          100% { transform: translateY(-105%); }
        }
      </style>

      <script is:inline>
        document.addEventListener('DOMContentLoaded', () => {
          const slides = document.querySelectorAll('.brush-slide-mobile');
          const caption = document.getElementById('brush-slide-caption-mobile');
          const container = document.getElementById('brush-slideshow-container-mobile');
          if (!container) return;
          
          const paperOverlay = document.getElementById('paper-wipe-overlay-mobile');
          const paperBody = paperOverlay.querySelector('.paper-body-mobile');
          const edges = paperOverlay.querySelectorAll('.paper-edge-mobile');
          
          let currentIdx = 0;
          let dirIdx = 0;
          const directions = ['lr', 'tb', 'rl', 'bt'];
          const colors = ['#ffd8ec', '#e5d9ff', '#fff2b2'];
          let colorIdx = 0;

          if (slides.length > 0 && caption && paperOverlay) {
            setInterval(() => {
              const currentDir = directions[dirIdx];
              const currentColor = colors[colorIdx];
              
              // 1. Configura a cor do papel e dos SVGs de borda
              paperBody.style.backgroundColor = currentColor;
              edges.forEach(edge => {
                edge.style.fill = currentColor;
                edge.classList.add('opacity-0');
                edge.classList.remove('opacity-100');
              });
              
              // 2. Ativa o SVG da borda de ataque correspondente
              let activeEdge;
              if (currentDir === 'lr') activeEdge = paperOverlay.querySelector('.edge-right-mobile');
              if (currentDir === 'rl') activeEdge = paperOverlay.querySelector('.edge-left-mobile');
              if (currentDir === 'tb') activeEdge = paperOverlay.querySelector('.edge-bottom-mobile');
              if (currentDir === 'bt') activeEdge = paperOverlay.querySelector('.edge-top-mobile');
              
              if (activeEdge) {
                activeEdge.classList.remove('opacity-0');
                activeEdge.classList.add('opacity-100');
              }
              
              // 3. Dispara a animação do papel
              paperOverlay.className = `paper-animate-${currentDir}-mobile`;
              
              // 4. No meio da animação (550ms, quando a tela está totalmente coberta pelo papel)
              // trocamos o slide e a legenda por baixo
              setTimeout(() => {
                slides[currentIdx].classList.remove('opacity-100', 'scale-100');
                slides[currentIdx].classList.add('opacity-0', 'scale-95');

                currentIdx = (currentIdx + 1) % slides.length;

                slides[currentIdx].classList.remove('opacity-0', 'scale-95');
                slides[currentIdx].classList.add('opacity-100', 'scale-100');

                caption.innerHTML = `<span class="material-symbols-outlined text-xs">stars</span> ${slides[currentIdx].getAttribute('data-caption')}`;
              }, 550);

              // 5. Após a conclusão (1200ms), limpa a classe e atualiza os índices
              setTimeout(() => {
                paperOverlay.className = '';
                dirIdx = (dirIdx + 1) % directions.length;
                colorIdx = (colorIdx + 1) % colors.length;
              }, 1250);

            }, 7000);
          }
        });
      </script>
    </div>

    <!-- Lista de Diferenciais Compacta -->
    <div class="grid grid-cols-3 gap-2">
      <div class="bg-white p-2.5 border-2 border-on-surface rounded-xl flex flex-col items-center text-center shadow-[2px_2px_0px_0px_rgba(0,0,0,1)]">
        <span class="material-symbols-outlined text-pink-600 text-xl mb-1">card_giftcard</span>
        <span class="font-label-bold text-[10px]">Caixinhas</span>
      </div>
      <div class="bg-white p-2.5 border-2 border-on-surface rounded-xl flex flex-col items-center text-center shadow-[2px_2px_0px_0px_rgba(0,0,0,1)]">
        <span class="material-symbols-outlined text-yellow-600 text-xl mb-1">cake</span>
        <span class="font-label-bold text-[10px]">Topper Bolo</span>
      </div>
      <div class="bg-white p-2.5 border-2 border-on-surface rounded-xl flex flex-col items-center text-center shadow-[2px_2px_0px_0px_rgba(0,0,0,1)]">
        <span class="material-symbols-outlined text-blue-600 text-xl mb-1">celebration</span>
        <span class="font-label-bold text-[10px]">Adesivos</span>
      </div>
    </div>

    <!-- CTAs Mobile -->
    <div class="flex flex-col gap-3">
      <a 
        href="/mobile/workshops" 
        class="bg-primary text-white border-2 border-black rounded-xl py-4 font-label-bold text-xs shadow-[3px_3px_0px_0px_rgba(0,0,0,1)] active:translate-x-0.5 active:translate-y-0.5 active:shadow-none transition-all text-center flex items-center justify-center gap-1.5"
      >
        <span class="material-symbols-outlined text-sm">auto_awesome</span> Conhecer Nossos Workshops
      </a>
      <a 
        href="https://wa.me/5531972122639?text=Olá!%20Gostaria%20de%20conversar%20sobre%20personalizados." 
        target="_blank"
        class="bg-white border-2 border-black rounded-xl py-4 font-label-bold text-xs shadow-[3px_3px_0px_0px_rgba(0,0,0,1)] active:translate-x-0.5 active:translate-y-0.5 active:shadow-none transition-all text-center text-primary flex items-center justify-center gap-1.5"
      >
