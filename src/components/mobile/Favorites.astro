---
// Mapeamento dinâmico no cliente a partir do Supabase
---

<!-- Product Grid: Favoritos da Semana -->
<section class="px-4 py-12">
  <div class="flex items-center gap-3 mb-8">
    <span class="material-symbols-outlined text-secondary-container text-4xl" style="font-variation-settings: 'FILL' 1;">star</span>
    <h2 class="font-headline-md text-headline-md-mobile text-primary">Favoritos da Semana</h2>
  </div>
  
  <div id="mobile-favorites-grid" class="grid grid-cols-2 gap-4 min-h-[150px]">
    <div class="col-span-2 text-center text-xs text-on-surface-variant py-8">Carregando favoritos...</div>
  </div>
</section>

<!-- Product Grid: Novidades -->
<section class="px-4 py-12 bg-surface-container-low">
  <div class="flex items-center gap-3 mb-8">
    <span class="material-symbols-outlined text-pink-600 text-4xl animate-pulse">auto_awesome</span>
    <h2 class="font-headline-md text-headline-md-mobile text-primary">Novidades</h2>
  </div>
  
  <div id="mobile-news-grid" class="grid grid-cols-2 gap-4 min-h-[150px]">
    <div class="col-span-2 text-center text-xs text-on-surface-variant py-8">Carregando novidades...</div>
  </div>
</section>

<!-- Product Grid: Mais Vendidos -->
<section class="px-4 py-12">
  <div class="flex items-center gap-3 mb-8">
    <span class="material-symbols-outlined text-yellow-500 text-4xl" style="font-variation-settings: 'FILL' 1;">workspace_premium</span>
    <h2 class="font-headline-md text-headline-md-mobile text-primary">Mais Vendidos</h2>
  </div>
  
  <div id="mobile-bestsellers-grid" class="grid grid-cols-2 gap-4 min-h-[150px]">
    <div class="col-span-2 text-center text-xs text-on-surface-variant py-8">Carregando mais vendidos...</div>
  </div>
  
  <a href="/mobile/catalogo" class="w-full mt-8 thin-border py-4 bg-surface-container rounded-2xl font-label-bold flex items-center justify-center gap-2 hover:bg-surface-container-high text-on-surface">
    Ver todos os produtos <span class="material-symbols-outlined">chevron_right</span>
  </a>
</section>

<script is:inline>
  async function loadHomeProductsMobile() {
    const favoritesGrid = document.getElementById('mobile-favorites-grid');
    const newsGrid = document.getElementById('mobile-news-grid');
    const bestsellersGrid = document.getElementById('mobile-bestsellers-grid');

    if (!window.SonharteDB) return;

    try {
      const products = await window.SonharteDB.getProducts();
      const activeProducts = products.filter(p => p.ativo !== false);

      // 1. Favoritos (selo "Destaque")
      let favorites = activeProducts.filter(p => p.destaque === 'Destaque');
      if (favorites.length === 0) {
        favorites = activeProducts.slice(0, 4);
      } else {
        favorites = favorites.slice(0, 4);
      }

      // 2. Novidades (selo "Lançamento")
      let news = activeProducts.filter(p => p.destaque === 'Lançamento');
      if (news.length === 0) {
        news = activeProducts.slice(4, 8);
      } else {
        news = news.slice(0, 4);
      }

      // 3. Mais Vendidos (selo "Mais Vendido")
      let bestSellers = activeProducts.filter(p => p.destaque === 'Mais Vendido');
      if (bestSellers.length === 0) {
        bestSellers = activeProducts.slice(8, 12);
      } else {
        bestSellers = bestSellers.slice(0, 4);
      }

      // Renderiza
      renderMobileGrid(favoritesGrid, favorites, 'primary', 'Destaque');
      renderMobileGrid(newsGrid, news, 'tertiary', 'Novo!');
      renderMobileGrid(bestsellersGrid, bestSellers, 'primary', 'Sucesso');

    } catch (err) {
      console.error("Erro ao carregar favoritos mobile:", err);
      if (favoritesGrid) favoritesGrid.innerHTML = '<p class="col-span-2 text-center text-xs text-red-600">Erro ao carregar favoritos.</p>';
      if (newsGrid) newsGrid.innerHTML = '<p class="col-span-2 text-center text-xs text-red-600">Erro ao carregar novidades.</p>';
      if (bestsellersGrid) bestsellersGrid.innerHTML = '<p class="col-span-2 text-center text-xs text-red-600">Erro ao carregar mais vendidos.</p>';
    }
  }

  function renderMobileGrid(container, list, themeColor, badgeText) {
    if (!container) return;
    container.innerHTML = '';

    if (list.length === 0) {
      container.innerHTML = '<p class="col-span-2 text-center text-xs text-on-surface-variant py-8">Nenhum produto nesta seção.</p>';
      return;
    }

    list.forEach((p, idx) => {
      const card = document.createElement('div');
      const shadowClass = idx % 2 === 0 ? 'block-shadow-primary' : 'block-shadow-tertiary';
      const buttonBg = themeColor === 'primary' ? 'bg-primary' : 'bg-tertiary';
      const buttonShadow = themeColor === 'primary' ? 'block-shadow-primary' : 'block-shadow-tertiary';
      const textTheme = themeColor === 'primary' ? 'text-primary' : 'text-tertiary';
      
      card.className = `thick-border rounded-2xl bg-white p-3.5 relative flex flex-col justify-between ${shadowClass}`;
      
      let badgeHtml = '';
      const isDestaque = idx === 0 && themeColor === 'primary' && badgeText === 'Destaque';
      
      if (isDestaque) {
        badgeHtml = `
          <div class="absolute -top-2.5 -left-2 bg-secondary-container text-on-secondary-container font-label-bold text-[8px] px-2 py-0.5 thick-border rounded-full z-20 rotate-[-5deg] flex items-center gap-0.5 shadow-md">
            <span class="material-symbols-outlined text-[8px]" style="font-variation-settings: 'FILL' 1;">auto_awesome</span> DESTAQUE
          </div>
        `;
      } else if (badgeText === 'Novo!') {
        badgeHtml = `
          <span class="absolute top-1.5 left-1.5 bg-tertiary text-white text-[8px] font-label-bold px-2 py-0.5 border border-black rounded-full shadow-[1px_1px_0px_0px_rgba(0,0,0,1)] z-10">
            Novo!
          </span>
        `;
      } else if (badgeText === 'Sucesso') {
        badgeHtml = `
          <span class="absolute top-1.5 left-1.5 bg-secondary-fixed text-on-secondary-fixed text-[8px] font-label-bold px-2 py-0.5 border border-black rounded-full shadow-[1px_1px_0px_0px_rgba(0,0,0,1)] z-10">
            Sucesso
          </span>
        `;
      }
      
      const priceVal = typeof p.preco === 'number' ? p.preco : parseFloat(p.preco || 0);
      const precoFormatado = priceVal.toFixed(2).replace('.', ',');
      const firstCat = p.categoria ? p.categoria.split('&')[0].trim() : 'Mimos';

      card.innerHTML = `
        <div>
          ${isDestaque ? badgeHtml : ''}
          <a href="/mobile/produto?id=${p.id}" class="block relative w-full aspect-square mb-2.5">
            <img class="w-full h-full object-cover rounded-xl thin-border" alt="${p.titulo}" src="${p.imagem}" />
            ${!isDestaque && badgeText !== 'Destaque' ? badgeHtml : ''}
            ${badgeText !== 'Novo!' && badgeText !== 'Sucesso' && !isDestaque ? `
            <span class="absolute top-1.5 left-1.5 bg-white text-on-surface text-[8px] font-label-bold px-2 py-0.5 border border-black rounded-full shadow-[1px_1px_0px_0px_rgba(0,0,0,1)] z-10">
              ${firstCat}
            </span>` : ''}
          </a>
          <a href="/mobile/produto?id=${p.id}">
            <h3 class="font-headline-md text-sm mb-1 font-bold text-on-surface hover:text-primary transition-colors">${p.titulo}</h3>
          </a>
        </div>
        <div class="flex items-center justify-between mt-3 gap-2">
          <span class="font-headline-md text-base ${textTheme} font-bold">R$ ${precoFormatado}</span>
          <button 
            class="add-to-cart-btn thin-border ${buttonBg} text-white p-2 rounded-lg ${buttonShadow} active:translate-x-0.5 active:translate-y-0.5 active:shadow-none shrink-0 flex items-center justify-center"
            data-id="${p.id}"
            data-titulo="${p.titulo}"
            data-preco="${p.preco}"
            data-imagem="${p.imagem}"
          >
            <span class="material-symbols-outlined text-xs">add_shopping_cart</span>
          </button>
        </div>
      `;
      container.appendChild(card);
    });
  }

  // Inicializa
  document.addEventListener('DOMContentLoaded', loadHomeProductsMobile);
  if (document.readyState === 'complete' || document.readyState === 'interactive') {
    loadHomeProductsMobile();
  }
</script>
