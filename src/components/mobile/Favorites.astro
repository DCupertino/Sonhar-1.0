---
import products from '../../data/produtos-mock.json';

// Selecionar produtos reais específicos
const favorites = [
  products.find(p => p.id === "1"),
  products.find(p => p.id === "6"),
  products.find(p => p.id === "21"),
  products.find(p => p.id === "12")
].filter(Boolean);

const news = [
  products.find(p => p.id === "73"),
  products.find(p => p.id === "76"),
  products.find(p => p.id === "84"),
  products.find(p => p.id === "88")
].filter(Boolean);

const bestSellers = [
  products.find(p => p.id === "3"),
  products.find(p => p.id === "22"),
  products.find(p => p.id === "32"),
  products.find(p => p.id === "50")
].filter(Boolean);
---

<!-- Product Grid: Favoritos da Semana -->
<section class="px-4 py-12">
  <div class="flex items-center gap-3 mb-8">
    <span class="material-symbols-outlined text-secondary-container text-4xl" style="font-variation-settings: 'FILL' 1;">star</span>
    <h2 class="font-headline-md text-headline-md-mobile text-primary">Favoritos da Semana</h2>
  </div>
  
  <div class="grid grid-cols-2 gap-4">
    {favorites.map((p, idx) => (
      <div class={`thick-border rounded-2xl bg-white p-3.5 relative flex flex-col justify-between ${idx % 2 === 0 ? 'block-shadow-primary' : 'block-shadow-tertiary'}`}>
        <div>
          {idx === 0 && (
            <div class="absolute -top-2.5 -left-2 bg-secondary-container text-on-secondary-container font-label-bold text-[8px] px-2 py-0.5 thick-border rounded-full z-10 rotate-[-5deg] flex items-center gap-0.5 shadow-md">
              <span class="material-symbols-outlined text-[8px]" style="font-variation-settings: 'FILL' 1;">auto_awesome</span> DESTAQUE
            </div>
          )}
          <a href={`/mobile/produto?id=${p.id}`} class="block relative w-full aspect-square mb-2.5">
            <img class="w-full h-full object-cover rounded-xl thin-border" alt={p.titulo} src={p.imagem} />
            <span class="absolute top-1 left-1 bg-white text-on-surface text-[8px] font-label-bold px-2 py-0.5 border border-black rounded-full shadow-[1px_1px_0px_0px_rgba(0,0,0,1)]">
              {p.categoria.split('&')[0].trim()}
            </span>
          </a>
          <a href={`/mobile/produto?id=${p.id}`}>
            <h3 class="font-headline-md text-sm mb-1 font-bold text-on-surface hover:text-primary transition-colors">{p.titulo}</h3>
          </a>
        </div>
        <div class="flex items-center justify-between mt-3 gap-2">
          <span class="font-headline-md text-base text-primary font-bold">R$ {p.preco.toFixed(2).replace('.', ',')}</span>
          <button 
            class="add-to-cart-btn thin-border bg-primary text-white p-2 rounded-lg block-shadow-primary active:translate-x-0.5 active:translate-y-0.5 active:shadow-none shrink-0 flex items-center justify-center"
            data-id={p.id}
            data-titulo={p.titulo}
            data-preco={p.preco}
            data-imagem={p.imagem}
          >
            <span class="material-symbols-outlined text-xs">add_shopping_cart</span>
          </button>
        </div>
      </div>
    ))}
  </div>
</section>

<!-- Product Grid: Novidades -->
<section class="px-4 py-12 bg-surface-container-low">
  <div class="flex items-center gap-3 mb-8">
    <span class="material-symbols-outlined text-pink-600 text-4xl animate-pulse">auto_awesome</span>
    <h2 class="font-headline-md text-headline-md-mobile text-primary">Novidades</h2>
  </div>
  
  <div class="grid grid-cols-2 gap-4">
    {news.map((p, idx) => (
      <div class={`thick-border rounded-2xl bg-white p-3.5 relative flex flex-col justify-between ${idx % 2 === 0 ? 'block-shadow-tertiary' : 'block-shadow-primary'}`}>
        <div>
          <a href={`/mobile/produto?id=${p.id}`} class="block relative w-full aspect-square mb-2.5">
            <img class="w-full h-full object-cover rounded-xl thin-border" alt={p.titulo} src={p.imagem} />
            <span class="absolute top-1 left-1 bg-tertiary text-white text-[8px] font-label-bold px-2 py-0.5 border border-black rounded-full shadow-[1px_1px_0px_0px_rgba(0,0,0,1)]">
              Novo!
            </span>
          </a>
          <a href={`/mobile/produto?id=${p.id}`}>
            <h3 class="font-headline-md text-sm mb-1 font-bold text-on-surface hover:text-primary transition-colors">{p.titulo}</h3>
          </a>
        </div>
        <div class="flex items-center justify-between mt-3 gap-2">
          <span class="font-headline-md text-base text-tertiary font-bold">R$ {p.preco.toFixed(2).replace('.', ',')}</span>
          <button 
            class="add-to-cart-btn thin-border bg-tertiary text-white p-2 rounded-lg block-shadow-tertiary active:translate-x-0.5 active:translate-y-0.5 active:shadow-none shrink-0 flex items-center justify-center"
            data-id={p.id}
            data-titulo={p.titulo}
            data-preco={p.preco}
            data-imagem={p.imagem}
          >
            <span class="material-symbols-outlined text-xs">add_shopping_cart</span>
          </button>
        </div>
      </div>
    ))}
  </div>
</section>

<!-- Product Grid: Mais Vendidos -->
<section class="px-4 py-12">
  <div class="flex items-center gap-3 mb-8">
    <span class="material-symbols-outlined text-yellow-500 text-4xl" style="font-variation-settings: 'FILL' 1;">workspace_premium</span>
    <h2 class="font-headline-md text-headline-md-mobile text-primary">Mais Vendidos</h2>
  </div>
  
  <div class="grid grid-cols-2 gap-4">
    {bestSellers.map((p, idx) => (
      <div class={`thick-border rounded-2xl bg-white p-3.5 relative flex flex-col justify-between ${idx % 2 === 0 ? 'block-shadow-primary' : 'block-shadow-tertiary'}`}>
        <div>
          <a href={`/mobile/produto?id=${p.id}`} class="block relative w-full aspect-square mb-2.5">
            <img class="w-full h-full object-cover rounded-xl thin-border" alt={p.titulo} src={p.imagem} />
            <span class="absolute top-1 left-1 bg-secondary-container text-on-secondary-fixed text-[8px] font-label-bold px-2 py-0.5 border border-black rounded-full shadow-[1px_1px_0px_0px_rgba(0,0,0,1)]">
              Sucesso
            </span>
          </a>
          <a href={`/mobile/produto?id=${p.id}`}>
            <h3 class="font-headline-md text-sm mb-1 font-bold text-on-surface hover:text-primary transition-colors">{p.titulo}</h3>
          </a>
        </div>
        <div class="flex items-center justify-between mt-3 gap-2">
          <span class="font-headline-md text-base text-primary font-bold">R$ {p.preco.toFixed(2).replace('.', ',')}</span>
          <button 
            class="add-to-cart-btn thin-border bg-primary text-white p-2 rounded-lg block-shadow-primary active:translate-x-0.5 active:translate-y-0.5 active:shadow-none shrink-0 flex items-center justify-center"
            data-id={p.id}
            data-titulo={p.titulo}
            data-preco={p.preco}
            data-imagem={p.imagem}
          >
            <span class="material-symbols-outlined text-xs">add_shopping_cart</span>
          </button>
        </div>
      </div>
    ))}
  </div>
  
  <a href="/mobile/catalogo" class="w-full mt-8 thin-border py-4 bg-surface-container rounded-2xl font-label-bold flex items-center justify-center gap-2 hover:bg-surface-container-high text-on-surface">
    Ver todos os produtos <span class="material-symbols-outlined">chevron_right</span>
  </a>
</section>
