<!-- Scrolling Horizontal Menu -->
<nav class="flex overflow-x-auto no-scrollbar gap-3 px-4 py-4 bg-surface-container-low border-b-2 border-on-background" id="mobile-horizontal-nav">
  <!-- Botão Criativo e Destacado de Workshops -->
  <a 
    href="/mobile/workshops" 
    class="workshop-nav-btn whitespace-nowrap px-4 py-2 border-2 border-black rounded-full bg-gradient-to-r from-[#FF007A] via-[#8F00FF] to-primary text-white font-label-bold flex items-center gap-1 shadow-[3px_3px_0px_0px_rgba(0,0,0,1)] active:translate-x-0.5 active:translate-y-0.5 active:shadow-none transition-all relative overflow-hidden shrink-0"
    id="nav-workshops-btn"
  >
    <span class="absolute inset-0 w-full h-full bg-white/25 transform -translate-x-full skew-x-12 animate-shine"></span>
    <span class="material-symbols-outlined text-[14px] animate-pulse-soft">auto_awesome</span>
    Workshops ✨
  </a>

  <button class="category-btn whitespace-nowrap px-4 py-2 thin-border rounded-full bg-secondary-fixed text-on-secondary-fixed font-label-bold block-shadow-secondary active:translate-x-0.5 active:translate-y-0.5 active:shadow-none" data-category="Todos">Todos</button>
  <button class="category-btn whitespace-nowrap px-4 py-2 thin-border rounded-full bg-white text-on-surface font-label-bold transition-all" data-category="Lápis de Cor & Desenho">Lápis de Cor & Desenho</button>
  <button class="category-btn whitespace-nowrap px-4 py-2 thin-border rounded-full bg-white text-on-surface font-label-bold transition-all" data-category="Cadernos & Papéis">Cadernos & Papéis</button>
  <button class="category-btn whitespace-nowrap px-4 py-2 thin-border rounded-full bg-white text-on-surface font-label-bold transition-all" data-category="Canetas & Escrita">Canetas & Escrita</button>
  <button class="category-btn whitespace-nowrap px-4 py-2 thin-border rounded-full bg-white text-on-surface font-label-bold transition-all" data-category="Artes & Utilidades">Artes & Utilidades</button>
  <button class="category-btn whitespace-nowrap px-4 py-2 thin-border rounded-full bg-white text-on-surface font-label-bold transition-all" data-category="Organização & Escritório">Organização & Escritório</button>
</nav>

<style>
  @keyframes shine {
    0% { transform: translateX(-150%) skewX(-15deg); }
    50% { transform: translateX(150%) skewX(-15deg); }
    100% { transform: translateX(150%) skewX(-15deg); }
  }
  .animate-shine {
    animation: shine 3.5s infinite ease-in-out;
  }
  
  @keyframes pulse-soft {
    0%, 100% { transform: scale(1) rotate(0deg); }
    50% { transform: scale(1.2) rotate(15deg); }
  }
  .animate-pulse-soft {
    display: inline-block;
    animation: pulse-soft 2s infinite ease-in-out;
  }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const nav = document.getElementById('mobile-horizontal-nav');
    if (!nav) return;
    const buttons = nav.querySelectorAll('.category-btn');
    
    buttons.forEach(btn => {
      btn.addEventListener('click', () => {
        const cat = btn.getAttribute('data-category') || 'Todos';
        
        // Se NÃO estiver na página de catálogo, redireciona
        if (!window.location.pathname.includes('/mobile/catalogo')) {
          window.location.href = `/mobile/catalogo?categoria=${encodeURIComponent(cat)}`;
          return;
        }

        buttons.forEach(b => {
          // Volta todos para o estado inativo
          b.className = "category-btn whitespace-nowrap px-4 py-2 thin-border rounded-full bg-white text-on-surface font-label-bold transition-all";
        });
        // Aplica o estado ativo no botão clicado
        btn.className = "category-btn whitespace-nowrap px-4 py-2 thin-border rounded-full bg-secondary-fixed text-on-secondary-fixed font-label-bold block-shadow-secondary active:translate-x-0.5 active:translate-y-0.5 active:shadow-none";
      });
    });
  });
</script>
