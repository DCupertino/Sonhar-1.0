      <style is:inline>
        #paper-wipe-overlay {
          position: absolute;
          inset: 0;
          z-index: 30;
          pointer-events: none;
          transform: translateX(105%);
        }
        .paper-body {
          position: absolute;
          inset: 0;
        }
        .paper-edge {
          position: absolute;
          pointer-events: none;
          transition: opacity 0.2s ease;
        }

        /* LR (Left to Right) */
        .paper-animate-lr {
          animation: paper-wipe-lr-anim 1.2s cubic-bezier(0.77, 0, 0.175, 1) forwards;
        }
        @keyframes paper-wipe-lr-anim {
          0% { transform: translateX(-105%); }
          45%, 55% { transform: translateX(0%); }
          100% { transform: translateX(105%); }
        }

        /* RL (Right to Left) */
        .paper-animate-rl {
          animation: paper-wipe-rl-anim 1.2s cubic-bezier(0.77, 0, 0.175, 1) forwards;
        }
        @keyframes paper-wipe-rl-anim {
          0% { transform: translateX(105%); }
          45%, 55% { transform: translateX(0%); }
          100% { transform: translateX(-105%); }
        }

        /* TB (Top to Bottom) */
        .paper-animate-tb {
          animation: paper-wipe-tb-anim 1.2s cubic-bezier(0.77, 0, 0.175, 1) forwards;
        }
        @keyframes paper-wipe-tb-anim {
          0% { transform: translateY(-105%); }
          45%, 55% { transform: translateY(0%); }
          100% { transform: translateY(105%); }
        }

        /* BT (Bottom to Top) */
        .paper-animate-bt {
          animation: paper-wipe-bt-anim 1.2s cubic-bezier(0.77, 0, 0.175, 1) forwards;
        }
        @keyframes paper-wipe-bt-anim {
          0% { transform: translateY(105%); }
          45%, 55% { transform: translateY(0%); }
          100% { transform: translateY(-105%); }
        }
      </style>

      <script is:inline>
        document.addEventListener('DOMContentLoaded', () => {
          const slides = document.querySelectorAll('.brush-slide');
          const caption = document.getElementById('brush-slide-caption');
          const container = document.getElementById('brush-slideshow-container');
          if (!container) return;
          
          const paperOverlay = document.getElementById('paper-wipe-overlay');
          const paperBody = paperOverlay.querySelector('.paper-body');
          const edges = paperOverlay.querySelectorAll('.paper-edge');
          
          let currentIdx = 0;
          let dirIdx = 0;
          const directions = ['lr', 'tb', 'rl', 'bt'];
          const colors = ['#ffd8ec', '#e5d9ff', '#fff2b2'];
          let colorIdx = 0;

          if (slides.length > 0 && caption && paperOverlay) {
            setInterval(() => {
              const currentDir = directions[dirIdx];
              const currentColor = colors[colorIdx];
              
              // 1. Configura a cor do papel e dos SVGs de borda
              paperBody.style.backgroundColor = currentColor;
              edges.forEach(edge => {
                edge.style.fill = currentColor;
                edge.classList.add('opacity-0');
                edge.classList.remove('opacity-100');
              });
              
              // 2. Ativa o SVG da borda de ataque correspondente
              let activeEdge;
              if (currentDir === 'lr') activeEdge = paperOverlay.querySelector('.edge-right');
              if (currentDir === 'rl') activeEdge = paperOverlay.querySelector('.edge-left');
              if (currentDir === 'tb') activeEdge = paperOverlay.querySelector('.edge-bottom');
              if (currentDir === 'bt') activeEdge = paperOverlay.querySelector('.edge-top');
              
              if (activeEdge) {
                activeEdge.classList.remove('opacity-0');
                activeEdge.classList.add('opacity-100');
              }
              
              // 3. Dispara a animação do papel
              paperOverlay.className = `paper-animate-${currentDir}`;
              
              // 4. No meio da animação (550ms, quando a tela está totalmente coberta pelo papel)
              // trocamos o slide e a legenda por baixo
              setTimeout(() => {
                slides[currentIdx].classList.remove('opacity-100', 'scale-100');
                slides[currentIdx].classList.add('opacity-0', 'scale-95');

                currentIdx = (currentIdx + 1) % slides.length;

                slides[currentIdx].classList.remove('opacity-0', 'scale-95');
                slides[currentIdx].classList.add('opacity-100', 'scale-100');

                caption.innerHTML = `<span class="material-symbols-outlined text-sm">stars</span> ${slides[currentIdx].getAttribute('data-caption')}`;
              }, 550);

              // 5. Após a conclusão (1200ms), limpa a classe e atualiza os índices
              setTimeout(() => {
                paperOverlay.className = '';
                dirIdx = (dirIdx + 1) % directions.length;
                colorIdx = (colorIdx + 1) % colors.length;
              }, 1250);

            }, 7000);
          }
        });
      </script>
    </div>

