---
import products from '../../data/produtos-mock.json';

// Selecionar produtos reais específicos
const favorites = [
  products.find(p => p.id === "1"),
  products.find(p => p.id === "6"),
  products.find(p => p.id === "21"),
  products.find(p => p.id === "12")
].filter(Boolean);

const news = [
  products.find(p => p.id === "73"),
  products.find(p => p.id === "76"),
  products.find(p => p.id === "84"),
  products.find(p => p.id === "88")
].filter(Boolean);

const bestSellers = [
  products.find(p => p.id === "3"),
  products.find(p => p.id === "22"),
  products.find(p => p.id === "32"),
  products.find(p => p.id === "50")
].filter(Boolean);
---

<!-- Bento Grid Products: Favoritos da Semana -->
<section class="px-gutter py-20 max-w-container-max mx-auto">
  <div class="flex flex-col md:flex-row justify-between items-end gap-6 mb-12">
    <div>
      <h2 class="font-headline-lg text-headline-lg text-primary">Favoritos da Semana</h2>
      <p class="font-body-md text-on-surface-variant">Os mimos que estão fazendo o coração vibrar!</p>
    </div>
    <a href="/catalogo" class="px-6 py-2 bg-surface cartoon-border cartoon-shadow rounded-lg font-label-bold hover-lift transition-all inline-block">Ver todos</a>
  </div>
  
  <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
    {favorites.length >= 4 && (
      <>
        <!-- Card 1 Bento (Grande Destaque) -->
        <div class="md:col-span-2 md:row-span-2 group">
          <div class="h-full cartoon-border cartoon-shadow-primary rounded-2xl bg-white overflow-hidden flex flex-col justify-between">
            <a href={`/produto?id=${favorites[0].id}`} class="block relative h-[75%] min-h-[350px]">
              <img alt={favorites[0].titulo} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" src={favorites[0].imagem} />
              <div class="absolute top-4 right-4 bg-error text-white px-3 py-1 cartoon-border rounded-full font-label-bold text-xs">Destaque</div>
            </a>
            <div class="p-4 flex-grow flex flex-col justify-between gap-2 bg-white">
              <div>
                <a href={`/produto?id=${favorites[0].id}`} class="hover:text-primary transition-colors">
                  <h3 class="font-headline-md text-base text-on-surface mb-1 font-bold">{favorites[0].titulo}</h3>
                </a>
              </div>
              <div class="flex justify-between items-center mt-2">
                <span class="text-xl font-headline-md text-primary font-bold">R$ {favorites[0].preco.toFixed(2).replace('.', ',')}</span>
                <button 
                  class="add-to-cart-btn bg-primary text-white px-5 py-1.5 cartoon-border rounded-lg active-press hover:bg-tertiary transition-colors text-xs"
                  data-id={favorites[0].id}
                  data-titulo={favorites[0].titulo}
                  data-preco={favorites[0].preco}
                  data-imagem={favorites[0].imagem}
                >
                  Eu quero!
                </button>
              </div>
            </div>
          </div>
        </div>

        <!-- Card 2 -->
        <div class="group">
          <div class="cartoon-border cartoon-shadow rounded-2xl bg-white overflow-hidden hover-lift transition-all">
            <a href={`/produto?id=${favorites[1].id}`} class="block aspect-square bg-secondary-fixed">
              <img alt={favorites[1].titulo} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" src={favorites[1].imagem} />
            </a>
            <div class="p-3.5 flex justify-between items-center bg-white gap-2">
              <div>
                <a href={`/produto?id=${favorites[1].id}`} class="hover:text-primary transition-colors">
                  <h4 class="font-headline-md text-on-surface text-sm truncate max-w-[110px] font-bold" title={favorites[1].titulo}>{favorites[1].titulo}</h4>
                </a>
                <span class="text-base font-bold text-tertiary">R$ {favorites[1].preco.toFixed(2).replace('.', ',')}</span>
              </div>
              <button 
                class="add-to-cart-btn p-1.5 bg-tertiary text-white rounded-lg border-2 border-black active-press hover:bg-primary transition-colors flex items-center justify-center shrink-0"
                data-id={favorites[1].id}
                data-titulo={favorites[1].titulo}
                data-preco={favorites[1].preco}
                data-imagem={favorites[1].imagem}
              >
                <span class="material-symbols-outlined text-xs">add_shopping_cart</span>
              </button>
            </div>
          </div>
        </div>

        <!-- Card 3 -->
        <div class="group">
          <div class="cartoon-border cartoon-shadow rounded-2xl bg-white overflow-hidden hover-lift transition-all">
            <a href={`/produto?id=${favorites[2].id}`} class="block aspect-square bg-tertiary-fixed">
              <img alt={favorites[2].titulo} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" src={favorites[2].imagem} />
            </a>
            <div class="p-3.5 flex justify-between items-center bg-white gap-2">
              <div>
                <a href={`/produto?id=${favorites[2].id}`} class="hover:text-primary transition-colors">
                  <h4 class="font-headline-md text-on-surface text-sm truncate max-w-[110px] font-bold" title={favorites[2].titulo}>{favorites[2].titulo}</h4>
                </a>
                <span class="text-base font-bold text-tertiary">R$ {favorites[2].preco.toFixed(2).replace('.', ',')}</span>
              </div>
              <button 
                class="add-to-cart-btn p-1.5 bg-tertiary text-white rounded-lg border-2 border-black active-press hover:bg-primary transition-colors flex items-center justify-center shrink-0"
                data-id={favorites[2].id}
                data-titulo={favorites[2].titulo}
                data-preco={favorites[2].preco}
                data-imagem={favorites[2].imagem}
              >
                <span class="material-symbols-outlined text-xs">add_shopping_cart</span>
              </button>
            </div>
          </div>
        </div>

        <!-- Card 4 (Horizontal Bento) -->
        <div class="md:col-span-2 group">
          <div class="cartoon-border cartoon-shadow rounded-2xl bg-white overflow-hidden flex items-center hover-lift transition-all h-full">
            <a href={`/produto?id=${favorites[3].id}`} class="w-[45%] aspect-square bg-primary-fixed shrink-0 block">
              <img alt={favorites[3].titulo} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" src={favorites[3].imagem} />
            </a>
            <div class="p-4 w-[55%] flex flex-col justify-between h-full gap-2">
              <div>
                <a href={`/produto?id=${favorites[3].id}`} class="hover:text-primary transition-colors">
                  <h4 class="font-headline-md text-base text-on-surface font-bold">{favorites[3].titulo}</h4>
                </a>
              </div>
              <div class="flex justify-between items-center mt-auto">
                <span class="text-lg font-bold text-primary font-headline-md">R$ {favorites[3].preco.toFixed(2).replace('.', ',')}</span>
                <button 
                  class="add-to-cart-btn bg-primary text-white px-4 py-2 cartoon-border rounded-lg active-press hover:bg-tertiary transition-colors text-xs"
                  data-id={favorites[3].id}
                  data-titulo={favorites[3].titulo}
                  data-preco={favorites[3].preco}
                  data-imagem={favorites[3].imagem}
                >
                  Eu quero!
                </button>
              </div>
            </div>
          </div>
        </div>
      </>
    )}
  </div>
</section>

<!-- Novidades Section -->
<section class="px-gutter py-16 bg-surface-container-low">
  <div class="max-w-container-max mx-auto mb-12">
    <h2 class="font-headline-lg text-headline-lg text-primary">Novidades da Semana</h2>
    <p class="font-body-md text-on-surface-variant">Os últimos mimos que acabaram de chegar na Sonharte!</p>
  </div>
  
  <div class="max-w-container-max mx-auto grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-8">
    {news.map(p => (
      <div class="group font-body-md">
        <div class="cartoon-border cartoon-shadow rounded-2xl bg-white overflow-hidden hover-lift transition-all flex flex-col justify-between h-full">
          <div>
            <a href={`/produto?id=${p.id}`} class="aspect-square bg-slate-50 relative overflow-hidden flex items-center justify-center block">
              <img alt={p.titulo} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" src={p.imagem} />
              <span class="absolute top-3 left-3 bg-tertiary text-white text-[10px] font-label-bold px-2 py-0.5 border border-black rounded-full shadow-[1px_1px_0px_0px_rgba(0,0,0,1)]">
                Novo!
              </span>
            </a>
            <div class="p-4">
              <a href={`/produto?id=${p.id}`} class="hover:text-primary transition-colors">
                <h4 class="font-headline-md text-on-surface text-sm mb-1 font-bold" title={p.titulo}>{p.titulo}</h4>
              </a>
            </div>
          </div>
          <div class="p-4 pt-0 flex justify-between items-center bg-white gap-2">
            <span class="text-base font-bold text-primary font-headline-md">R$ {p.preco.toFixed(2).replace('.', ',')}</span>
            <button 
              class="add-to-cart-btn p-2 bg-primary text-white rounded-lg border-2 border-black active-press hover:bg-tertiary transition-colors flex items-center justify-center shrink-0"
              data-id={p.id}
              data-titulo={p.titulo}
              data-preco={p.preco}
              data-imagem={p.imagem}
            >
              <span class="material-symbols-outlined text-xs">add_shopping_cart</span>
            </button>
          </div>
        </div>
      </div>
    ))}
  </div>
</section>

<!-- Mais Vendidos Section -->
<section class="px-gutter py-20 max-w-container-max mx-auto">
  <div class="mb-12">
    <h2 class="font-headline-lg text-headline-lg text-primary">Mais Vendidos</h2>
    <p class="font-body-md text-on-surface-variant">Os queridinhos que todo mundo está amando levar para casa!</p>
  </div>
  
  <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-8">
    {bestSellers.map(p => (
      <div class="group font-body-md">
        <div class="cartoon-border cartoon-shadow rounded-2xl bg-white overflow-hidden hover-lift transition-all flex flex-col justify-between h-full">
          <div>
            <a href={`/produto?id=${p.id}`} class="aspect-square bg-slate-50 relative overflow-hidden flex items-center justify-center block">
              <img alt={p.titulo} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" src={p.imagem} />
              <span class="absolute top-3 left-3 bg-secondary-container text-on-secondary-fixed text-[10px] font-label-bold px-2.5 py-0.5 border border-black rounded-full shadow-[1px_1px_0px_0px_rgba(0,0,0,1)]">
                ★ Sucesso
              </span>
            </a>
            <div class="p-4">
              <a href={`/produto?id=${p.id}`} class="hover:text-primary transition-colors">
                <h4 class="font-headline-md text-on-surface text-sm mb-1 font-bold" title={p.titulo}>{p.titulo}</h4>
              </a>
            </div>
          </div>
          <div class="p-4 pt-0 flex justify-between items-center bg-white gap-2">
            <span class="text-base font-bold text-tertiary font-headline-md">R$ {p.preco.toFixed(2).replace('.', ',')}</span>
            <button 
              class="add-to-cart-btn p-2 bg-tertiary text-white rounded-lg border-2 border-black active-press hover:bg-primary transition-colors flex items-center justify-center shrink-0"
              data-id={p.id}
              data-titulo={p.titulo}
              data-preco={p.preco}
              data-imagem={p.imagem}
            >
              <span class="material-symbols-outlined text-xs">add_shopping_cart</span>
            </button>
          </div>
        </div>
      </div>
    ))}
  </div>
</section>
