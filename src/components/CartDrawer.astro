<!-- Cart Drawer Overlay -->
<div id="cart-overlay" class="fixed inset-0 bg-black/50 z-[90] hidden opacity-0 transition-opacity duration-300 backdrop-blur-sm"></div>

<!-- Cart Drawer Container -->
<aside id="cart-drawer" class="fixed right-0 top-0 h-full w-[320px] sm:w-[380px] bg-surface border-l-4 border-on-background z-[100] translate-x-full transition-transform duration-300 ease-out flex flex-col shadow-[-10px_0px_0px_0px_rgba(0,0,0,0.15)]">
  <!-- Header -->
  <div class="p-6 bg-primary-container text-on-primary-container border-b-4 border-on-background flex justify-between items-center shrink-0">
    <div class="flex items-center gap-2">
      <span class="material-symbols-outlined text-2xl">shopping_cart</span>
      <h2 class="font-headline-md text-xl tracking-tight">Sacola de Sonhos</h2>
    </div>
    <button id="cart-close-btn" class="material-symbols-outlined text-2xl p-1 bg-white text-on-surface border-2 border-on-background rounded-lg hover:scale-105 active:scale-95 transition-transform flex items-center justify-center">
      close
    </button>
  </div>

  <!-- Cart Content (Scrollable) -->
  <div class="flex-grow overflow-y-auto p-4 flex flex-col gap-4 no-scrollbar" id="cart-items-container">
    <!-- Items will be injected dynamically here -->
    <div class="flex flex-col items-center justify-center h-full text-center text-on-surface-variant py-12">
      <span class="material-symbols-outlined text-5xl mb-4 opacity-40">shopping_bag</span>
      <p class="font-label-bold text-lg">Sua sacola está vazia!</p>
      <p class="text-sm mt-1">Navegue pelas abas e adicione seus mimos favoritos.</p>
    </div>
  </div>

  <!-- Footer (Fixed in Drawer) -->
  <div class="p-6 bg-surface-container-high border-t-4 border-on-background flex flex-col gap-4 shrink-0">
    <div class="flex justify-between items-center">
      <span class="font-label-bold text-lg text-on-surface-variant">Valor Total:</span>
      <span class="font-headline-md text-2xl text-primary" id="cart-total-value">R$ 0,00</span>
    </div>
    <a 
      id="cart-checkout-btn" 
      href="#" 
      target="_blank"
      class="w-full py-4 bg-tertiary text-white text-center font-label-bold text-lg border-4 border-on-background rounded-xl shadow-[4px_4px_0px_0px_rgba(0,0,0,1)] hover:-translate-y-0.5 active:translate-y-0.5 hover:shadow-[2px_2px_0px_0px_rgba(0,0,0,1)] active:shadow-none transition-all flex items-center justify-center gap-2 pointer-events-none opacity-50"
    >
      <span class="material-symbols-outlined">send</span> Finalizar no WhatsApp
    </a>
  </div>
</aside>

<script is:inline>
  // O telefone do WhatsApp da loja (com DDI + DDD)
  const WHATSAPP_PHONE = '5531972122639'; // Telefone extraído do logo original

  function toggleCartDrawer() {
    const drawer = document.getElementById('cart-drawer');
    const overlay = document.getElementById('cart-overlay');
    if (!drawer || !overlay) return;

    const isOpen = !drawer.classList.contains('translate-x-full');

    if (isOpen) {
      // Fechar
      drawer.classList.add('translate-x-full');
      overlay.classList.remove('opacity-100');
      setTimeout(() => overlay.classList.add('hidden'), 300);
      document.body.classList.remove('overflow-hidden');
    } else {
      // Abrir
      overlay.classList.remove('hidden');
      setTimeout(() => overlay.classList.add('opacity-100'), 10);
      drawer.classList.remove('translate-x-full');
      document.body.classList.add('overflow-hidden');
    }
  }
  
  window.toggleCartDrawer = toggleCartDrawer;

  function renderCartItems() {
    const container = document.getElementById('cart-items-container');
    const totalEl = document.getElementById('cart-total-value');
    const checkoutBtn = document.getElementById('cart-checkout-btn');
    if (!container || !window.SonharteCart) return;

    const cart = window.SonharteCart.get();
    
    if (cart.length === 0) {
      container.innerHTML = `
        <div class="flex flex-col items-center justify-center h-full text-center text-on-surface-variant py-12">
          <span class="material-symbols-outlined text-5xl mb-4 opacity-40">shopping_bag</span>
          <p class="font-label-bold text-lg">Sua sacola está vazia!</p>
          <p class="text-sm mt-1">Navegue pelas abas e adicione seus mimos favoritos.</p>
        </div>
      `;
      totalEl.textContent = 'R$ 0,00';
      checkoutBtn.classList.add('pointer-events-none', 'opacity-50');
      checkoutBtn.href = '#';
      return;
    }

    // Renderizar itens
    let html = '';
    cart.forEach(item => {
      html += `
        <div class="flex gap-4 p-3 bg-white border-2 border-on-background rounded-xl shadow-[3px_3px_0px_0px_rgba(0,0,0,1)] items-center">
          <img src="${item.imagem}" alt="${item.titulo}" class="w-16 h-16 object-cover border-2 border-on-background rounded-lg shrink-0" />
          <div class="flex-grow min-w-0">
            <h4 class="font-label-bold text-sm truncate text-on-surface">${item.titulo}</h4>
            <div class="flex justify-between items-center mt-2">
              <span class="font-bold text-primary text-sm">R$ ${(item.preco * item.quantidade).toFixed(2)}</span>
              <!-- Controle de Qtd -->
              <div class="flex items-center border border-on-background rounded-lg overflow-hidden bg-surface-container-low shrink-0 scale-90">
                <button class="px-2 py-1 hover:bg-surface-variant font-bold btn-minus" data-id="${item.id}">-</button>
                <span class="px-3 py-1 bg-white text-xs font-label-bold border-x border-on-background min-w-[28px] text-center">${item.quantidade}</span>
                <button class="px-2 py-1 hover:bg-surface-variant font-bold btn-plus" data-id="${item.id}">+</button>
              </div>
            </div>
          </div>
          <button class="material-symbols-outlined text-error hover:scale-110 active:scale-95 transition-transform shrink-0 p-1 btn-remove" data-id="${item.id}">
            delete
          </button>
        </div>
      `;
    });

    container.innerHTML = html;
    totalEl.textContent = `R$ ${window.SonharteCart.total().toFixed(2)}`;
    checkoutBtn.classList.remove('pointer-events-none', 'opacity-50');
    checkoutBtn.href = window.SonharteCart.link(WHATSAPP_PHONE);

    // Adicionar eventos aos botões recém-criados
    container.querySelectorAll('.btn-plus').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        const id = btn.getAttribute('data-id');
        const item = window.SonharteCart.get().find(i => String(i.id) === String(id));
        if (item) {
          window.SonharteCart.add(item.id, item.titulo, item.preco, item.imagem);
        }
      });
    });

    container.querySelectorAll('.btn-minus').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        const id = btn.getAttribute('data-id');
        window.SonharteCart.decrease(id);
      });
    });

    container.querySelectorAll('.btn-remove').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        const id = btn.getAttribute('data-id');
        window.SonharteCart.remove(id);
      });
    });
  }

  // Configuração inicial ao carregar a página
  document.addEventListener('DOMContentLoaded', () => {
    // Configurar botões de fechar e overlay
    const closeBtn = document.getElementById('cart-close-btn');
    const overlay = document.getElementById('cart-overlay');
    if (closeBtn) closeBtn.addEventListener('click', toggleCartDrawer);
    if (overlay) overlay.addEventListener('click', toggleCartDrawer);

    // Capturar cliques nos botões de cabeçalho (Desktop e Mobile)
    const desktopCartBtn = document.getElementById('desktop-cart-btn');
    const mobileCartBtn = document.getElementById('mobile-cart-btn');
    if (desktopCartBtn) desktopCartBtn.addEventListener('click', toggleCartDrawer);
    if (mobileCartBtn) mobileCartBtn.addEventListener('click', toggleCartDrawer);

    // Escutar atualizações do carrinho
    window.addEventListener('cart-updated', renderCartItems);
    
    // Forçar primeira renderização
    renderCartItems();

    // Delegação de evento de clique global para qualquer botão ".add-to-cart-btn"
    document.addEventListener('click', (e) => {
      const btn = e.target.closest('.add-to-cart-btn');
      if (!btn || !window.SonharteCart) return;

      e.preventDefault();
      const id = btn.getAttribute('data-id');
      const titulo = btn.getAttribute('data-titulo');
      const preco = btn.getAttribute('data-preco');
      const imagem = btn.getAttribute('data-imagem');

      if (id && titulo && preco && imagem) {
        window.SonharteCart.add(id, titulo, parseFloat(preco), imagem);
        
        // Efeito de animação nos botões de carrinho (desktop e mobile)
        const desktopCartBtn = document.getElementById('desktop-cart-btn');
        const mobileCartBtn = document.getElementById('mobile-cart-btn');
        if (desktopCartBtn) {
          desktopCartBtn.classList.add('animate-cart-bounce');
          setTimeout(() => desktopCartBtn.classList.remove('animate-cart-bounce'), 800);
        }
        if (mobileCartBtn) {
          mobileCartBtn.classList.add('animate-cart-bounce');
          setTimeout(() => mobileCartBtn.classList.remove('animate-cart-bounce'), 800);
        }
        
        // Abre a gaveta se ela estiver fechada
        const drawer = document.getElementById('cart-drawer');
        const isOpen = drawer && !drawer.classList.contains('translate-x-full');
        if (!isOpen) {
          toggleCartDrawer();
        }
      }
    });
  });
</script>
