---
interface Props {
  title: string;
}

const { title } = Astro.props;
import '../styles/global.css';
import CartDrawer from '../components/CartDrawer.astro';

const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL || '';
const supabaseAnonKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY || '';
---

<!doctype html>
<html class="scroll-smooth" lang="pt-br">
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      (function() {
        const isMobilePage = window.location.pathname.startsWith('/mobile');
        const isMobileDevice = window.innerWidth < 768 || /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent);
        
        if (isMobileDevice && !isMobilePage) {
          let newPath = '/mobile' + window.location.pathname;
          if (window.location.pathname === '/') {
            newPath = '/mobile';
          }
          window.location.href = newPath + window.location.search + window.location.hash;
        } else if (!isMobileDevice && isMobilePage) {
          let newPath = window.location.pathname.replace(/^\/mobile/, '');
          if (newPath === '') {
            newPath = '/';
          }
          window.location.href = newPath + window.location.search + window.location.hash;
        }
      })();
    </script>
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <meta name="description" content="Sonharte - Papelaria Criativa, Mimos Afetivos e Workshops Personalizados. Tornando seus momentos inesquecíveis! ✨" />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://sonharte.com.br/" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content="Sonharte - Papelaria Criativa, Mimos Afetivos e Workshops Personalizados. Tornando seus momentos inesquecíveis! ✨" />
    <meta property="og:image" content="/assets/logo_clean.png" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content="Sonharte - Papelaria Criativa, Mimos Afetivos e Workshops Personalizados. Tornando seus momentos inesquecíveis! ✨" />
    <meta property="twitter:image" content="/assets/logo_clean.png" />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/assets/logo_clean.png" />

    <link href="/assets/17edea699b9b27907616409003241ce2.css" rel="stylesheet" />
    <link href="/assets/a39f5c6fcbb87b419667ec984d2e579a.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2/dist/umd/supabase.js" is:inline></script>
    <script is:inline define:vars={{ supabaseUrl, supabaseAnonKey }}>
      window.SUPABASE_URL = supabaseUrl;
      window.SUPABASE_ANON_KEY = supabaseAnonKey;
    </script>
    <script src="/assets/db.js" is:inline></script>
    <script src="/assets/cart.js" is:inline></script>
    <title>{title}</title>
  </head>
  <body class="font-body-md text-on-background overflow-x-hidden selection:bg-secondary-container">
    <slot />
    <CartDrawer />
    <!-- Canvas para efeito lúdico do botão de coração -->
    <canvas id="brush-effect-canvas" style="position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; pointer-events: none; z-index: 999999; display: block;"></canvas>
    <script is:inline>
      (function() {
        const canvas = document.getElementById('brush-effect-canvas');
        if (!canvas) return;
        const ctx = canvas.getContext('2d');
        
        let brushes = [];
        let animationFrameId = null;
        
        function resizeCanvas() {
          canvas.width = window.innerWidth;
          canvas.height = window.innerHeight;
        }
        
        window.addEventListener('resize', resizeCanvas);
        resizeCanvas();
        
        class Brush {
          constructor() {
            const side = Math.floor(Math.random() * 4); // 0: E->D, 1: D->E, 2: C->B, 3: B->C
            const w = window.innerWidth;
            const h = window.innerHeight;
            
            this.t = 0;
            this.speed = 0.003 + Math.random() * 0.0025; // duração ~3 a 5 seg
            this.hue = Math.floor(Math.random() * 360);
            this.angle = Math.random() * Math.PI * 2;
            this.angleSpeed = (0.05 + Math.random() * 0.07) * (Math.random() < 0.5 ? 1 : -1);
            
            this.radiusBase = 20 + Math.random() * 35;
            
            this.path = [];
            this.maxPathLen = 75;
            this.active = true;
            this.lineWidth = 3 + Math.random() * 2;
            
            switch(side) {
              case 0:
                this.startX = -100;
                this.startY = h * (0.15 + Math.random() * 0.7);
                this.endX = w + 100;
                this.endY = h * (0.15 + Math.random() * 0.7);
                break;
              case 1:
                this.startX = w + 100;
                this.startY = h * (0.15 + Math.random() * 0.7);
                this.endX = -100;
                this.endY = h * (0.15 + Math.random() * 0.7);
                break;
              case 2:
                this.startX = w * (0.15 + Math.random() * 0.7);
                this.startY = -100;
                this.endX = w * (0.15 + Math.random() * 0.7);
                this.endY = h + 100;
                break;
              case 3:
                this.startX = w * (0.15 + Math.random() * 0.7);
                this.startY = h + 100;
                this.endX = w * (0.15 + Math.random() * 0.7);
                this.endY = -100;
                break;
            }
            
            this.x = this.startX;
            this.y = this.startY;
          }
          
          update() {
            if (!this.active) {
              if (this.path.length > 0) {
                this.path.shift();
              }
              return;
            }
            
            this.t += this.speed;
            if (this.t >= 1) {
              this.t = 1;
              this.active = false;
            }
            
            const baseX = this.startX + (this.endX - this.startX) * this.t;
            const baseY = this.startY + (this.endY - this.startY) * this.t;
            
            this.angle += this.angleSpeed;
            const currentRadius = this.radiusBase * (1 + 0.4 * Math.sin(this.t * Math.PI * 8));
            
            this.x = baseX + Math.cos(this.angle) * currentRadius;
            this.y = baseY + Math.sin(this.angle) * currentRadius;
            
            this.hue = (this.hue + 2) % 360;
            
            this.path.push({ x: this.x, y: this.y, hue: this.hue });
            if (this.path.length > this.maxPathLen) {
              this.path.shift();
            }
          }
          
          draw(ctx) {
            if (this.path.length < 2) return;
            
            ctx.lineCap = 'round';
            ctx.lineJoin = 'round';
            
            for (let i = 0; i < this.path.length - 1; i++) {
              const pt1 = this.path[i];
              const pt2 = this.path[i + 1];
              const opacity = i / this.path.length;
              
              ctx.beginPath();
              ctx.moveTo(pt1.x, pt1.y);
              ctx.lineTo(pt2.x, pt2.y);
              
              ctx.lineWidth = this.lineWidth * (0.4 + 0.6 * opacity);
              ctx.strokeStyle = `hsla(${pt1.hue}, 90%, 65%, ${opacity * 0.85})`;
              ctx.stroke();
            }
          }
        }
        
        function animate() {
          ctx.clearRect(0, 0, canvas.width, canvas.height);
          
          let hasVisibleBrushes = false;
          
          for (let i = 0; i < brushes.length; i++) {
            const brush = brushes[i];
            brush.update();
            brush.draw(ctx);
            if (brush.active || brush.path.length > 0) {
              hasVisibleBrushes = true;
            }
          }
          
          brushes = brushes.filter(b => b.active || b.path.length > 0);
          
          if (hasVisibleBrushes && brushes.length > 0) {
            animationFrameId = requestAnimationFrame(animate);
          } else {
            animationFrameId = null;
            ctx.clearRect(0, 0, canvas.width, canvas.height);
          }
        }
        
        function startEffect() {
          const count = 2 + Math.floor(Math.random() * 2);
          for (let i = 0; i < count; i++) {
            setTimeout(() => {
              brushes.push(new Brush());
              if (!animationFrameId) {
                animate();
              }
            }, i * 250);
          }
        }
        
        document.addEventListener('click', function(e) {
          const target = e.target.closest('.heart-btn-effect');
          if (target) {
            startEffect();
          }
        });
      })();
    </script>
  </body>
</html>
